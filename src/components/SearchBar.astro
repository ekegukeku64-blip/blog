---
const base = import.meta.env.BASE_URL;
---

<div class="relative">
  <button
    id="search-toggle"
    class="p-2 rounded-lg text-text-muted hover:text-text hover:bg-surface-alt dark:text-dark-text-muted dark:hover:text-dark-text dark:hover:bg-dark-surface-alt transition-colors"
    aria-label="搜索"
  >
    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
    </svg>
  </button>
</div>

<!-- Search Modal -->
<div id="search-modal" class="fixed inset-0 z-[100] hidden">
  <!-- Backdrop -->
  <div class="absolute inset-0 bg-black/50 backdrop-blur-sm" id="search-backdrop"></div>

  <!-- Search Panel -->
  <div class="relative max-w-2xl mx-auto mt-[15vh] px-4">
    <div class="bg-surface dark:bg-dark-surface rounded-xl shadow-2xl border border-border dark:border-dark-border overflow-hidden">
      <!-- Search Input -->
      <div class="flex items-center px-4 border-b border-border dark:border-dark-border">
        <svg class="w-5 h-5 text-text-muted dark:text-dark-text-muted flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
        <input
          type="text"
          id="search-input"
          placeholder="搜索文章..."
          class="w-full px-3 py-4 bg-transparent text-text dark:text-dark-text placeholder:text-text-muted dark:placeholder:text-dark-text-muted focus:outline-none"
        />
        <kbd class="hidden sm:inline-block px-2 py-0.5 text-xs text-text-muted dark:text-dark-text-muted bg-surface-alt dark:bg-dark-surface-alt rounded">ESC</kbd>
      </div>

      <!-- Results -->
      <div id="search-results" class="max-h-[60vh] overflow-y-auto p-2">
        <div class="px-4 py-8 text-center text-text-muted dark:text-dark-text-muted">
          输入关键词开始搜索
        </div>
      </div>

      <!-- Footer -->
      <div class="px-4 py-2 border-t border-border dark:border-dark-border text-xs text-text-muted dark:text-dark-text-muted flex items-center justify-between">
        <span>由 Pagefind 提供搜索</span>
        <div class="flex items-center gap-2">
          <kbd class="px-1.5 py-0.5 bg-surface-alt dark:bg-dark-surface-alt rounded">↑↓</kbd>
          <span>导航</span>
          <kbd class="px-1.5 py-0.5 bg-surface-alt dark:bg-dark-surface-alt rounded">↵</kbd>
          <span>打开</span>
        </div>
      </div>
    </div>
  </div>
</div>

<script is:inline>
  let pagefind;

  async function initSearch() {
    if (!pagefind) {
      try {
        pagefind = await import('/blog/pagefind/pagefind.js');
        await pagefind.options({ languages: ['zh'] });
      } catch (e) {
        console.warn('Pagefind not available in dev mode');
      }
    }
  }

  function openSearch() {
    const modal = document.getElementById('search-modal');
    modal.classList.remove('hidden');
    document.getElementById('search-input').focus();
    document.body.style.overflow = 'hidden';
  }

  function closeSearch() {
    const modal = document.getElementById('search-modal');
    modal.classList.add('hidden');
    document.getElementById('search-input').value = '';
    document.getElementById('search-results').innerHTML = '<div class="px-4 py-8 text-center text-text-muted dark:text-dark-text-muted">输入关键词开始搜索</div>';
    document.body.style.overflow = '';
  }

  function renderResults(results) {
    const container = document.getElementById('search-results');
    if (!results || results.length === 0) {
      container.innerHTML = '<div class="px-4 py-8 text-center text-text-muted dark:text-dark-text-muted">没有找到相关文章</div>';
      return;
    }

    container.innerHTML = results.map((result, i) => `
      <a href="${result.url}" class="block px-4 py-3 rounded-lg hover:bg-surface-alt dark:hover:bg-dark-surface-alt transition-colors ${i === 0 ? 'bg-surface-alt dark:bg-dark-surface-alt' : ''}">
        <div class="font-medium text-text dark:text-dark-text">${result.meta?.title || '无标题'}</div>
        <div class="text-sm text-text-muted dark:text-dark-text-muted mt-1 line-clamp-2">${result.excerpt}</div>
        ${result.meta?.tags ? `<div class="flex flex-wrap gap-1 mt-2">${result.meta.tags.split(',').map(tag => `<span class="text-xs px-2 py-0.5 rounded-full bg-accent/10 dark:bg-dark-accent/10 text-accent dark:text-dark-accent">${tag.trim()}</span>`).join('')}</div>` : ''}
      </a>
    `).join('');
  }

  // Initialize
  document.addEventListener('astro:page-load', () => {
    const toggle = document.getElementById('search-toggle');
    const backdrop = document.getElementById('search-backdrop');
    const input = document.getElementById('search-input');
    let debounceTimer;

    toggle?.addEventListener('click', () => {
      initSearch();
      openSearch();
    });

    backdrop?.addEventListener('click', closeSearch);

    // Keyboard shortcuts
    document.addEventListener('keydown', (e) => {
      if (e.key === 'k' && (e.metaKey || e.ctrlKey)) {
        e.preventDefault();
        initSearch();
        openSearch();
      }
      if (e.key === 'Escape') {
        closeSearch();
      }
    });

    // Search input
    input?.addEventListener('input', (e) => {
      clearTimeout(debounceTimer);
      debounceTimer = setTimeout(async () => {
        const query = e.target.value.trim();
        if (!pagefind || !query) {
          document.getElementById('search-results').innerHTML = query
            ? '<div class="px-4 py-8 text-center text-text-muted dark:text-dark-text-muted">搜索未就绪，请刷新页面</div>'
            : '<div class="px-4 py-8 text-center text-text-muted dark:text-dark-text-muted">输入关键词开始搜索</div>';
          return;
        }
        const search = await pagefind.debouncedSearch(query);
        if (search) {
          const results = await Promise.all(search.results.slice(0, 10).map(r => r.data()));
          renderResults(results);
        }
      }, 200);
    });

    // Keyboard navigation
    input?.addEventListener('keydown', (e) => {
      const container = document.getElementById('search-results');
      const links = container.querySelectorAll('a');
      const current = container.querySelector('a.bg-surface-alt, a.dark\\:bg-dark-surface-alt');
      let index = Array.from(links).indexOf(current);

      if (e.key === 'ArrowDown') {
        e.preventDefault();
        index = Math.min(index + 1, links.length - 1);
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        index = Math.max(index - 1, 0);
      } else if (e.key === 'Enter' && current) {
        e.preventDefault();
        current.click();
        return;
      } else {
        return;
      }

      links.forEach(l => l.classList.remove('bg-surface-alt', 'dark:bg-dark-surface-alt'));
      if (links[index]) {
        links[index].classList.add('bg-surface-alt', 'dark:bg-dark-surface-alt');
        links[index].scrollIntoView({ block: 'nearest' });
      }
    });
  });
</script>
