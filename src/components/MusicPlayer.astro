---
interface Track {
  name: string;
  src: string;
  icon: string;
}

const tracks: Track[] = [
  { name: '雨声', src: 'rain.wav', icon: '🌧' },
  { name: '溪流', src: 'stream.wav', icon: '💧' },
  { name: '夜林', src: 'forest.wav', icon: '🌲' },
];

const musicBase = `${import.meta.env.BASE_URL}music/`;
---

<div id="music-player" class="music-player" aria-label="音乐播放器">
  <!-- 展开面板 -->
  <div class="music-panel" id="music-panel">
    <div class="music-panel-inner">
      <span class="music-now-playing" id="music-label">雨声</span>
      <div class="music-controls">
        <button class="music-btn" id="music-prev" aria-label="上一首">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 20L9 12l10-8v16zM5 19V5" />
          </svg>
        </button>
        <button class="music-btn music-btn-play" id="music-toggle" aria-label="播放">
          <svg id="music-icon-play" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <svg id="music-icon-pause" class="w-5 h-5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10 9v6m4-6v6m7-3a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </button>
        <button class="music-btn" id="music-next" aria-label="下一首">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 4l10 8-10 8V4zM19 5v14" />
          </svg>
        </button>
      </div>
      <div class="music-tracks" id="music-tracks">
        {tracks.map((t, i) => (
          <button class="music-track" data-index={i} data-src={`${musicBase}${t.src}`} data-name={t.name}>
            <span>{t.icon}</span>
            <span>{t.name}</span>
          </button>
        ))}
        <button class="music-track music-track-custom" id="music-custom-btn" data-name="自定义" title="粘贴音频链接">
          <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
          </svg>
          <span>自定义</span>
        </button>
      </div>
      <!-- 自定义链接输入 -->
      <div class="music-custom-input" id="music-custom-row" style="display:none">
        <input
          type="text"
          id="music-url-input"
          class="music-url-input"
          placeholder="粘贴音频链接..."
          spellcheck="false"
        />
        <button class="music-btn" id="music-url-play" aria-label="播放自定义链接">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
          </svg>
        </button>
        <label class="music-btn music-file-label" aria-label="选择本地文件" title="选择本地文件">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 15v4c0 1.1.9 2 2 2h14a2 2 0 002-2v-4M17 9l-5 5-5-5M12 4v10" />
          </svg>
          <input type="file" id="music-file-input" accept="audio/*" class="music-file-hidden" />
        </label>
      </div>
    </div>
  </div>

  <!-- 浮动按钮 -->
  <button class="music-trigger" id="music-trigger" aria-label="音乐">
    <svg class="w-5 h-5 music-trigger-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3" />
    </svg>
  </button>
</div>

<audio id="music-audio" preload="none" loop></audio>

<style>
  .music-player {
    position: fixed;
    bottom: 2rem;
    right: 2rem;
    z-index: 49;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.75rem;
  }

  .music-trigger {
    width: 44px;
    height: 44px;
    border-radius: 14px;
    border: 2px solid #7a95af;
    background: rgba(15, 23, 42, 0.85);
    backdrop-filter: blur(12px);
    color: #7a95af;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    z-index: 2;
  }

  .music-trigger:hover {
    background: #7a95af;
    color: #070A13;
    transform: scale(1.08);
    box-shadow: 0 0 24px rgba(122, 149, 175, 0.25);
  }

  .music-trigger:active {
    transform: scale(0.95);
    transition: transform 0.1s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .music-trigger.is-playing {
    border-color: #7a95af;
    background: rgba(122, 149, 175, 0.15);
  }

  .music-trigger.is-playing .music-trigger-icon {
    animation: musicPulse 2s ease-in-out infinite;
  }

  @keyframes musicPulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.5; }
  }

  .music-panel {
    max-height: 0;
    opacity: 0;
    overflow: hidden;
    transform: translateY(8px);
    transition: max-height 0.45s cubic-bezier(0.16, 1, 0.3, 1),
                opacity 0.35s cubic-bezier(0.16, 1, 0.3, 1),
                transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    pointer-events: none;
  }

  .music-panel.is-open {
    max-height: 320px;
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  .music-panel-inner {
    background: rgba(15, 23, 42, 0.92);
    backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 16px;
    padding: 1rem;
    width: 200px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }

  .music-now-playing {
    font-family: 'Noto Serif SC', serif;
    font-size: 13px;
    font-weight: 600;
    color: #F5F5F4;
    letter-spacing: 0.04em;
  }

  .music-controls {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .music-btn {
    width: 32px;
    height: 32px;
    border-radius: 10px;
    border: 1px solid rgba(255, 255, 255, 0.06);
    background: rgba(255, 255, 255, 0.04);
    color: #d6dae1;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.25s ease;
  }

  .music-btn:hover {
    background: rgba(255, 255, 255, 0.1);
    color: #F5F5F4;
  }

  .music-btn-play {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border-color: rgba(122, 149, 175, 0.3);
    background: rgba(122, 149, 175, 0.12);
    color: #7a95af;
  }

  .music-btn-play:hover {
    border-color: #7a95af;
    background: rgba(122, 149, 175, 0.2);
  }

  .music-tracks {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .music-track {
    padding: 4px 10px;
    border-radius: 20px;
    border: 1px solid rgba(255, 255, 255, 0.05);
    background: rgba(255, 255, 255, 0.03);
    color: #d6dae1;
    font-size: 11px;
    font-family: 'Noto Serif SC', serif;
    cursor: pointer;
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .music-track:hover {
    background: rgba(255, 255, 255, 0.08);
    color: #F5F5F4;
  }

  .music-track.is-active {
    border-color: rgba(122, 149, 175, 0.4);
    background: rgba(122, 149, 175, 0.12);
    color: #7a95af;
    font-weight: 600;
  }

  .music-track-custom {
    border-style: dashed;
    border-color: rgba(255, 255, 255, 0.08);
  }

  .music-track-custom:hover {
    border-color: rgba(122, 149, 175, 0.3);
  }

  /* 自定义链接输入 */
  .music-custom-input {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    width: 100%;
  }

  .music-url-input {
    flex: 1;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 8px;
    padding: 5px 10px;
    font-size: 11px;
    color: #d6dae1;
    font-family: 'JetBrains Mono', monospace;
    outline: none;
    transition: border-color 0.3s ease;
    min-width: 0;
  }

  .music-url-input::placeholder {
    color: rgba(214, 218, 225, 0.3);
  }

  .music-url-input:focus {
    border-color: rgba(122, 149, 175, 0.5);
  }

  .music-file-label {
    cursor: pointer;
    position: relative;
  }

  .music-file-hidden {
    position: absolute;
    inset: 0;
    opacity: 0;
    cursor: pointer;
  }
</style>

<script is:inline>
  function initMusicPlayer() {
    const audio = document.getElementById('music-audio');
    const panel = document.getElementById('music-panel');
    const trigger = document.getElementById('music-trigger');
    const toggle = document.getElementById('music-toggle');
    const prev = document.getElementById('music-prev');
    const next = document.getElementById('music-next');
    const label = document.getElementById('music-label');
    const iconPlay = document.getElementById('music-icon-play');
    const iconPause = document.getElementById('music-icon-pause');
    const trackBtns = document.querySelectorAll('.music-track');
    const customBtn = document.getElementById('music-custom-btn');
    const customRow = document.getElementById('music-custom-row');
    const urlInput = document.getElementById('music-url-input');
    const urlPlay = document.getElementById('music-url-play');
    const fileInput = document.getElementById('music-file-input');

    if (!audio || !panel || !trigger) return;

    // 从 DOM 读取预设曲目
    const builtin: { name: string; src: string }[] = [];
    trackBtns.forEach(btn => {
      const s = btn.getAttribute('data-src');
      if (s) builtin.push({ name: btn.getAttribute('data-name') || '', src: s });
    });

    // 曲目池 = 预设 + 动态自定义
    let tracks = [...builtin];
    let currentIndex = 0;

    function updateUI() {
      if (label) label.textContent = tracks[currentIndex]?.name || '未知';
      // 高亮预设曲目按钮
      trackBtns.forEach((t, i) => {
        if (t.getAttribute('data-src')) {
          t.classList.toggle('is-active', i === currentIndex);
        } else {
          // 自定义按钮：当前正在播放自定义曲目时高亮
          t.classList.toggle('is-active', currentIndex >= builtin.length);
        }
      });
      if (!audio.paused) {
        iconPlay?.classList.add('hidden');
        iconPause?.classList.remove('hidden');
        trigger.classList.add('is-playing');
      } else {
        iconPlay?.classList.remove('hidden');
        iconPause?.classList.add('hidden');
        trigger.classList.remove('is-playing');
      }
    }

    function loadTrack(index: number) {
      currentIndex = index;
      audio.src = tracks[index]?.src || '';
      audio.load();
      updateUI();
    }

    function togglePlay() {
      if (audio.paused) {
        audio.play().catch(() => {});
      } else {
        audio.pause();
      }
      updateUI();
    }

    function nextTrack() {
      loadTrack((currentIndex + 1) % tracks.length);
      audio.play().catch(() => {});
    }

    function prevTrack() {
      loadTrack((currentIndex - 1 + tracks.length) % tracks.length);
      audio.play().catch(() => {});
    }

    function playCustomUrl() {
      const url = urlInput?.value.trim();
      if (!url) return;
      // 替换或新增自定义曲目
      const existingIdx = tracks.findIndex((_, i) => i >= builtin.length);
      if (existingIdx >= 0) {
        tracks.splice(existingIdx, 1, { name: '自定义', src: url });
        currentIndex = existingIdx;
      } else {
        tracks.push({ name: '自定义', src: url });
        currentIndex = tracks.length - 1;
      }
      loadTrack(currentIndex);
      audio.play().catch(() => {});
    }

    function playCustomFile(file: File) {
      const url = URL.createObjectURL(file);
      const name = file.name.replace(/\.[^.]+$/, '');
      const existingIdx = tracks.findIndex((_, i) => i >= builtin.length);
      if (existingIdx >= 0) {
        tracks.splice(existingIdx, 1, { name, src: url });
        currentIndex = existingIdx;
      } else {
        tracks.push({ name, src: url });
        currentIndex = tracks.length - 1;
      }
      loadTrack(currentIndex);
      audio.play().catch(() => {});
    }

    trigger.addEventListener('click', () => {
      panel.classList.toggle('is-open');
    });

    toggle?.addEventListener('click', (e) => {
      e.stopPropagation();
      togglePlay();
    });

    next?.addEventListener('click', (e) => {
      e.stopPropagation();
      nextTrack();
    });

    prev?.addEventListener('click', (e) => {
      e.stopPropagation();
      prevTrack();
    });

    trackBtns.forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const idx = parseInt(btn.getAttribute('data-index') || '0');
        const src = btn.getAttribute('data-src');
        if (src && idx !== currentIndex) {
          // 预设曲目
          loadTrack(idx);
          audio.play().catch(() => {});
        } else if (!src) {
          // 自定义按钮 — 展开/收起 URL 输入行
          const row = document.getElementById('music-custom-row');
          if (row) row.style.display = row.style.display === 'none' ? 'flex' : 'none';
          urlInput?.focus();
        }
      });
    });

    urlPlay?.addEventListener('click', (e) => {
      e.stopPropagation();
      playCustomUrl();
    });

    urlInput?.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        e.preventDefault();
        playCustomUrl();
      }
      e.stopPropagation();
    });

    fileInput?.addEventListener('change', () => {
      const file = fileInput.files?.[0];
      if (file) playCustomFile(file);
    });

    document.addEventListener('click', (e) => {
      const player = document.getElementById('music-player');
      if (player && !player.contains(e.target)) {
        panel.classList.remove('is-open');
      }
    });

    audio.addEventListener('play', updateUI);
    audio.addEventListener('pause', updateUI);
    audio.addEventListener('ended', () => nextTrack());

    loadTrack(0);
    updateUI();
  }

  initMusicPlayer();
  document.addEventListener('astro:page-load', initMusicPlayer);
</script>
