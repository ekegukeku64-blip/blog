---
import SearchBar from './SearchBar.astro';
const base = import.meta.env.BASE_URL;
const navLinks = [
  { href: base, label: '首页' },
  { href: `${base}blog/`, label: '文章' },
  { href: `${base}archive/`, label: '归档' },
  { href: `${base}tags/`, label: '标签' },
  { href: `${base}tools/`, label: '工具' },
  { href: 'https://ekegukeku64-blip.github.io/tech-daily/', label: '日报', external: true },
  { href: `${base}friends/`, label: '友链' },
  { href: `${base}guestbook/`, label: '留言' },
  { href: `${base}about/`, label: '关于' },
];

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 w-full px-4 md:px-8">
  <div class="header-glass max-w-6xl mx-auto rounded-3xl backdrop-blur-[20px] border border-white/[0.06]">
  <nav class="px-4 h-14 flex items-center justify-between md:px-6">
    <a href={import.meta.env.BASE_URL} class="logo-text text-xl font-semibold text-[#F5F5F4] hover:text-[#c8d6e8] transition-all duration-500" style="font-family: 'Noto Serif SC', serif;">墨迹</a>

    <div class="hidden md:flex items-center gap-1 rounded-full border border-white/[0.06] bg-white/[0.04] p-1">
      {navLinks.map(({ href, label, external }) => (
        <a
          href={href}
          class:list={[
            'rounded-full px-3.5 py-1.5 text-sm font-medium transition-colors',
            !external && (href === base ? currentPath === href : currentPath.startsWith(href))
              ? 'bg-white/10 text-[#F5F5F4]'
              : 'text-[#d6dae1] hover:bg-white/10 hover:text-[#F5F5F4]',
          ]}
          {...(external ? { target: '_blank', rel: 'noopener' } : {})}
        >
          {label}
          {external && (
            <svg class="inline w-3 h-3 ml-0.5 -mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          )}
        </a>
      ))}
    </div>

    <!-- Right side: search + mobile menu -->
    <div class="flex items-center gap-1">
      <SearchBar />
      <a
        href={`${import.meta.env.BASE_URL}rss.xml`}
        class="p-2 rounded-lg text-[#d6dae1] hover:text-[#7a95af] hover:bg-white/5 transition-colors"
        aria-label="RSS 订阅"
        target="_blank"
      >
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 5c7.18 0 13 5.82 13 13M6 11a7 7 0 017 7m-6 0a1 1 0 11-2 0 1 1 0 012 0z" />
        </svg>
      </a>
      <!-- Mobile menu button -->
      <button
        id="mobile-menu-toggle"
        class="md:hidden p-2 rounded-lg text-[#d6dae1] hover:text-[#F5F5F4] hover:bg-white/5 transition-colors"
        aria-label="菜单"
      >
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path class="menu-line menu-line-1" stroke-linecap="round" stroke-linejoin="round" d="M4 6h16" />
          <path class="menu-line menu-line-2" stroke-linecap="round" stroke-linejoin="round" d="M4 12h16" />
          <path class="menu-line menu-line-3" stroke-linecap="round" stroke-linejoin="round" d="M4 18h16" />
        </svg>
      </button>
    </div>
  </nav>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="md:hidden border-t border-white/5 bg-[rgba(15,23,42,0.92)] backdrop-blur-xl rounded-b-2xl">
    <div class="px-6 py-4 flex flex-col gap-1">
      {navLinks.map(({ href, label, external }) => (
        <a
          href={href}
          class:list={[
            'px-4 py-2.5 rounded-lg text-sm font-medium transition-colors',
            !external && (href === base ? currentPath === href : currentPath.startsWith(href))
              ? 'text-[#7a95af]'
              : 'text-[#d6dae1] hover:text-[#F5F5F4] hover:bg-white/5',
          ]}
          {...(external ? { target: '_blank', rel: 'noopener' } : {})}
        >
          {label}
          {external && (
            <svg class="inline w-3 h-3 ml-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          )}
        </a>
      ))}
      <a
        href={`${import.meta.env.BASE_URL}rss.xml`}
        class="px-4 py-2.5 rounded-lg text-sm font-medium transition-colors text-[#d6dae1] hover:text-[#F5F5F4] hover:bg-white/5 flex items-center gap-2"
        target="_blank"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 5c7.18 0 13 5.82 13 13M6 11a7 7 0 017 7m-6 0a1 1 0 11-2 0 1 1 0 012 0z" />
        </svg>
        RSS 订阅
      </a>
    </div>
  </div>
  </div>
</header>

<script is:inline define:vars={{ base: import.meta.env.BASE_URL }}>
  const ACTIVE = 'rounded-full px-3.5 py-1.5 text-sm font-medium transition-all duration-400 bg-white/10 text-[#F5F5F4]';
  const INACTIVE = 'rounded-full px-3.5 py-1.5 text-sm font-medium transition-all duration-400 text-[#d6dae1] hover:bg-white/10 hover:text-[#F5F5F4]';

  function updateActiveNav() {
    const p = window.location.pathname;
    document.querySelectorAll('nav a[href]').forEach(a => {
      const href = a.getAttribute('href');
      if (!href || href === base + '_astro/' || !href.startsWith(base)) return;
      const active = href === base ? p === href : p.startsWith(href);
      a.className = active ? ACTIVE : INACTIVE;
    });
  }

  document.addEventListener('astro:page-load', () => {
    updateActiveNav();

    const toggle = document.getElementById('mobile-menu-toggle');
    const menu = document.getElementById('mobile-menu');
    // Close mobile menu on navigation
    menu?.classList.remove('mobile-menu-open');
    toggle?.classList.remove('menu-open');
    toggle?.addEventListener('click', () => {
      menu?.classList.toggle('mobile-menu-open');
      toggle.classList.toggle('menu-open');
    });

    // Header 滚动隐藏/显示
    const header = document.querySelector('header');
    if (header && !window.__headerScroll) {
      window.__headerScroll = true;
      let lastY = 0;
      let ticking = false;
      window.addEventListener('scroll', () => {
        if (!ticking) {
          requestAnimationFrame(() => {
            const y = window.scrollY;
            if (y > 20) {
              header.classList.add('header-scrolled');
            } else {
              header.classList.remove('header-scrolled');
            }
            if (y > 80 && y > lastY) {
              header.classList.add('header-hidden');
            } else {
              header.classList.remove('header-hidden');
            }
            lastY = y;
            ticking = false;
          });
          ticking = true;
        }
      });
    }
  });
</script>
