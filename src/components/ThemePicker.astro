---
// 主题色切换 — 多种 accent 色可选
---

<div id="theme-picker" class="fixed bottom-8 left-20 z-50 hidden">
  <div class="bg-surface dark:bg-dark-surface border border-border/60 dark:border-dark-border/60 rounded-xl p-3 shadow-xl shadow-black/10 dark:shadow-black/30 flex gap-2 backdrop-blur-sm">
    <button data-color="#c23a2b" class="theme-dot w-6 h-6 rounded-full bg-[#c23a2b] border-2 border-transparent hover:border-text dark:hover:border-dark-text transition-colors" title="朱砂红"></button>
    <button data-color="#2563eb" class="theme-dot w-6 h-6 rounded-full bg-[#2563eb] border-2 border-transparent hover:border-text dark:hover:border-dark-text transition-colors" title="青蓝"></button>
    <button data-color="#059669" class="theme-dot w-6 h-6 rounded-full bg-[#059669] border-2 border-transparent hover:border-text dark:hover:border-dark-text transition-colors" title="竹青"></button>
    <button data-color="#7c3aed" class="theme-dot w-6 h-6 rounded-full bg-[#7c3aed] border-2 border-transparent hover:border-text dark:hover:border-dark-text transition-colors" title="紫墨"></button>
    <button data-color="#d97706" class="theme-dot w-6 h-6 rounded-full bg-[#d97706] border-2 border-transparent hover:border-text dark:hover:border-dark-text transition-colors" title="琥珀"></button>
  </div>
</div>

<button id="theme-picker-toggle"
  class="fixed bottom-8 left-20 z-50 w-9 h-9 flex items-center justify-center
         border border-border/60 dark:border-dark-border/60 rounded-xl
         bg-surface/80 dark:bg-dark-surface/80 backdrop-blur-sm
         text-text-muted dark:text-dark-text-muted
         hover:text-accent dark:hover:text-dark-accent hover:border-accent dark:hover:border-dark-accent
         hover:shadow-md hover:shadow-accent/10 dark:hover:shadow-dark-accent/10
         transition-all duration-300"
  aria-label="主题色">
  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
    <path stroke-linecap="round" stroke-linejoin="round" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01" />
  </svg>
</button>

<script is:inline>
  document.addEventListener('astro:page-load', () => {
    const toggle = document.getElementById('theme-picker-toggle');
    const picker = document.getElementById('theme-picker');
    if (!toggle || !picker) return;

    toggle.addEventListener('click', () => {
      picker.classList.toggle('hidden');
    });

    // 加载保存的主题色
    const savedColor = localStorage.getItem('accent_color');
    if (savedColor) applyColor(savedColor);

    picker.querySelectorAll('.theme-dot').forEach(dot => {
      if (dot.dataset.color === savedColor) {
        dot.classList.add('border-text', 'dark:border-dark-text');
      }
      dot.addEventListener('click', () => {
        const color = dot.dataset.color;
        applyColor(color);
        localStorage.setItem('accent_color', color);
        picker.querySelectorAll('.theme-dot').forEach(d => d.classList.remove('border-text', 'dark:border-dark-text'));
        dot.classList.add('border-text', 'dark:border-dark-text');
      });
    });

    function applyColor(color) {
      document.documentElement.style.setProperty('--color-accent', color);
      // 生成暗色变体（简单加深）
      const r = parseInt(color.slice(1,3), 16);
      const g = parseInt(color.slice(3,5), 16);
      const b = parseInt(color.slice(5,7), 16);
      const light = `rgb(${Math.min(255,r+30)},${Math.min(255,g+30)},${Math.min(255,b+30)})`;
      document.documentElement.style.setProperty('--color-accent-light', light);
      document.documentElement.style.setProperty('--color-dark-accent', color);
    }

    // 点击外部关闭
    document.addEventListener('click', (e) => {
      if (!picker.contains(e.target) && e.target !== toggle && !toggle.contains(e.target)) {
        picker.classList.add('hidden');
      }
    });
  });
</script>
