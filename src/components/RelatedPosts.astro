---
interface Props {
  currentSlug: string;
  tags: string[];
}

const { currentSlug, tags } = Astro.props;
const base = import.meta.env.BASE_URL;

// Get all posts
const allPosts = await import.meta.glob('../content/posts/*.md', { eager: true });
const posts = Object.values(allPosts) as any[];

// Find related posts by matching tags
const related = posts
  .filter(post => post.file && !post.file.includes(currentSlug))
  .map(post => {
    const postTags = post.frontmatter?.tags || [];
    const matchCount = postTags.filter((t: string) => tags.includes(t)).length;
    return { ...post, matchCount };
  })
  .filter(post => post.matchCount > 0)
  .sort((a, b) => b.matchCount - a.matchCount)
  .slice(0, 3);

function formatDate(date: Date) {
  return date.toLocaleDateString('zh-CN', { month: 'short', day: 'numeric' });
}

function getSlug(file: string) {
  const filename = file.split('/').pop()?.replace('.md', '') || '';
  return filename;
}
---

{related.length > 0 && (
  <div class="mt-14 pt-8 border-t border-border/40 dark:border-dark-border/40">
    <h3 class="font-display text-sm font-semibold tracking-widest text-text-muted dark:text-dark-text-muted mb-6">
      相关文章
    </h3>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
      {related.map(post => {
        const slug = getSlug(post.file);
        return (
          <a
            href={`${base}blog/${slug}`}
            class="group block p-5 border border-border/40 dark:border-dark-border/40
                   hover:border-accent/60 dark:hover:border-dark-accent/60
                   hover:-translate-y-0.5 hover:shadow-lg hover:shadow-accent/5 dark:hover:shadow-dark-accent/5
                   transition-all duration-300 rounded-xl bg-gradient-to-br from-surface/50 to-surface-alt/30 dark:from-dark-surface/50 dark:to-dark-surface-alt/30"
          >
            <h4 class="font-display text-base font-bold text-text dark:text-dark-text leading-snug
                        group-hover:text-accent dark:group-hover:text-dark-accent transition-colors">
              {post.frontmatter?.title}
            </h4>
            <p class="mt-2 text-sm text-text-muted dark:text-dark-text-muted line-clamp-2">
              {post.frontmatter?.description}
            </p>
            <div class="mt-3 flex flex-wrap gap-1.5">
              {post.frontmatter?.tags?.slice(0, 2).map((tag: string) => (
                <span class="text-xs px-2 py-0.5 rounded-full bg-accent/10 dark:bg-dark-accent/10 text-accent dark:text-dark-accent">
                  {tag}
                </span>
              ))}
            </div>
          </a>
        );
      })}
    </div>
  </div>
)}
