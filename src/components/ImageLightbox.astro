---
// 图片灯箱 — 点击文章图片放大查看，带平滑过渡
---

<div id="lightbox" class="fixed inset-0 z-[200] flex items-center justify-center cursor-zoom-out"
  style="opacity:0;pointer-events:none;background:rgba(0,0,0,0);backdrop-filter:blur(0px);visibility:hidden;transition:opacity 0.35s ease, background 0.35s ease, backdrop-filter 0.35s ease, visibility 0s 0.35s">
  <img id="lightbox-img" class="max-w-[90vw] max-h-[90vh] rounded-lg shadow-2xl object-contain"
    style="transform:scale(0.92);transition:transform 0.4s cubic-bezier(0.16, 1, 0.3, 1)" />
  <button id="lightbox-close" class="absolute top-6 right-6 text-white/50 hover:text-white transition-all duration-300 hover:scale-110" aria-label="关闭">
    <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
    </svg>
  </button>
</div>

<script is:inline>
  document.addEventListener('astro:page-load', () => {
    const lightbox = document.getElementById('lightbox');
    const lightboxImg = document.getElementById('lightbox-img');
    const closeBtn = document.getElementById('lightbox-close');
    if (!lightbox || !lightboxImg || !closeBtn) return;

    function open(src, alt) {
      lightboxImg.src = src;
      lightboxImg.alt = alt;
      lightbox.style.visibility = 'visible';
      lightbox.style.pointerEvents = 'auto';
      requestAnimationFrame(() => {
        lightbox.style.opacity = '1';
        lightbox.style.background = 'rgba(0,0,0,0.75)';
        lightbox.style.backdropFilter = 'blur(8px)';
        lightboxImg.style.transform = 'scale(1)';
      });
    }

    function close() {
      lightbox.style.opacity = '0';
      lightbox.style.background = 'rgba(0,0,0,0)';
      lightbox.style.backdropFilter = 'blur(0px)';
      lightboxImg.style.transform = 'scale(0.92)';
      lightbox.style.pointerEvents = 'none';
      lightbox.style.visibility = 'hidden';
      lightbox.style.transition = 'opacity 0.35s ease, background 0.35s ease, backdrop-filter 0.35s ease, visibility 0s 0.35s';
      setTimeout(() => { lightboxImg.src = ''; }, 400);
    }

    document.querySelectorAll('.prose img').forEach(img => {
      img.style.cursor = 'zoom-in';
      img.addEventListener('click', () => open(img.src, img.alt));
    });

    lightbox.addEventListener('click', (e) => {
      if (e.target === lightbox || e.target === closeBtn) close();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') close();
    });
  });
</script>
