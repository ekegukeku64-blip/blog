---
interface Props {
  focusCards: { label: string; text: string; href: string }[];
  postCount: number;
  thisMonth: number;
  wordCount: string;
  streak: number;
}

const { focusCards, postCount, thisMonth, wordCount, streak } = Astro.props;
---

<section class="home-hero">
  <div class="home-hero-inner">
    <div class="home-hero-main">
      <p class="home-hero-kicker">AI tools / honest notes / useful experiments</p>
      <h1 class="home-hero-title">
        <span class="home-hero-title-line">记录，</span>
        <span class="home-hero-title-line home-hero-title-line--accent">然后发生。</span>
      </h1>
      <p class="home-hero-desc">
        一个把 AI 工具踩坑、实用小项目和真实成长记录放在一起的空间。
        不装专家，只展示执行力怎么把想法变成东西。
      </p>
      <div class="home-hero-actions">
        <a href={`${import.meta.env.BASE_URL}blog/`} class="home-hero-btn home-hero-btn--primary">
          开始阅读
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
        <a href={`${import.meta.env.BASE_URL}tools/`} class="home-hero-btn home-hero-btn--secondary">
          看工具箱
        </a>
      </div>

      <div class="home-focus-row">
        {focusCards.map((card) => (
          <a href={card.href} class="home-focus-chip">
            <span>{card.label}</span>
            <span>{card.text}</span>
          </a>
        ))}
      </div>
    </div>

    <div class="home-hero-stats">
      <div class="home-stats-card">
        <div class="home-stats-label">文章</div>
        <div class="home-stats-number">{postCount}</div>
        <div class="home-stats-bar" style="width: 100%"></div>

        <div class="home-stats-label" style="margin-top: 1.25rem">本月</div>
        <div class="home-stats-number">{thisMonth}</div>
        <div class="home-stats-bar" style={`width: ${Math.min(thisMonth / 5 * 100, 100)}%`}></div>

        <div class="home-stats-label" style="margin-top: 1.25rem">字数</div>
        <div class="home-stats-number">{wordCount}</div>
        <div class="home-stats-bar" style="width: 80%"></div>

        {streak > 0 && (
          <p class="home-stats-streak">连续更新 {streak} 天</p>
        )}
      </div>
    </div>
  </div>
</section>

<style>
.home-hero {
  position: relative;
  width: 100%;
  padding: 3rem 2rem 4rem;
  overflow: hidden;
}

.home-hero::before {
  content: "";
  position: absolute;
  inset: 0;
  background: radial-gradient(ellipse 70% 60% at 30% 30%, rgba(122,149,175,0.08) 0%, transparent 60%),
              radial-gradient(ellipse 50% 50% at 80% 70%, rgba(200,182,142,0.04) 0%, transparent 50%);
  pointer-events: none;
}

.home-hero-inner {
  position: relative;
  display: flex;
  gap: 5rem;
  max-width: 1200px;
  margin: 0 auto;
  align-items: center;
  min-height: 60vh;
}

.home-hero-main {
  flex: 1;
  min-width: 0;
  animation: heroFadeIn 0.7s 0.1s cubic-bezier(0.16,1,0.3,1) both;
}

.home-hero-kicker {
  font-size: 0.65rem;
  letter-spacing: 0.35em;
  text-transform: uppercase;
  color: rgba(168, 175, 186, 0.5);
  margin-bottom: 2rem;
  font-family: var(--font-sans);
}

.home-hero-title {
  font-family: var(--font-display);
  font-size: clamp(2.8rem, 6vw, 5rem);
  font-weight: 800;
  line-height: 1.08;
  letter-spacing: 0.06em;
  margin-bottom: 1.5rem;
}

.home-hero-title-line {
  display: block;
  color: rgba(250, 250, 249, 0.92);
}

.home-hero-title-line--accent {
  color: rgba(200, 182, 142, 0.75);
  font-weight: 700;
}

.home-hero-desc {
  max-width: 480px;
  font-family: var(--font-serif);
  font-size: 1rem;
  line-height: 1.85;
  color: rgba(168, 175, 186, 0.7);
  margin-bottom: 2.5rem;
}

.home-hero-actions {
  display: flex;
  gap: 1rem;
  margin-bottom: 2.5rem;
}

.home-hero-btn {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.65rem 1.75rem;
  font-size: 0.85rem;
  font-weight: 500;
  border-radius: 9999px;
  transition: all 0.45s cubic-bezier(0.16,1,0.3,1);
  text-decoration: none;
}

.home-hero-btn--primary {
  background: rgba(200, 182, 142, 0.10);
  border: 1px solid rgba(200, 182, 142, 0.15);
  color: var(--color-text);
}
.home-hero-btn--primary:hover {
  background: rgba(200, 182, 142, 0.18);
  border-color: rgba(200, 182, 142, 0.25);
  transform: scale(1.03);
}

.home-hero-btn--secondary {
  background: transparent;
  border: 1px solid rgba(255,255,255,0.08);
  color: var(--color-text-secondary);
}
.home-hero-btn--secondary:hover {
  border-color: rgba(200,182,142,0.2);
  color: var(--color-text);
  transform: scale(1.03);
}

.home-focus-row {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
}

.home-focus-chip {
  display: block;
  padding: 0.75rem 1rem;
  border-radius: 0.75rem;
  border: 1px solid rgba(255,255,255,0.05);
  background: linear-gradient(135deg, rgba(255,255,255,0.03), rgba(255,255,255,0.01));
  text-decoration: none;
  transition: all 0.4s cubic-bezier(0.16,1,0.3,1);
  flex: 1;
  min-width: 140px;
}
.home-focus-chip:hover {
  border-color: rgba(122,149,175,0.2);
  background: linear-gradient(135deg, rgba(122,149,175,0.06), rgba(255,255,255,0.015));
  transform: translateY(-2px);
}
.home-focus-chip span:first-child {
  display: block;
  font-family: var(--font-mono);
  font-size: 0.65rem;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--color-accent);
  margin-bottom: 0.35rem;
}
.home-focus-chip span:last-child {
  display: block;
  font-family: var(--font-serif);
  font-size: 0.75rem;
  color: rgba(168, 175, 186, 0.6);
  line-height: 1.6;
}

.home-hero-stats {
  flex-shrink: 0;
  width: 240px;
  animation: heroFadeIn 0.7s 0.25s cubic-bezier(0.16,1,0.3,1) both;
}

.home-stats-card {
  background: rgba(10,14,22,0.40);
  backdrop-filter: blur(20px) saturate(120%);
  border: 1px solid rgba(255,255,255,0.06);
  border-radius: 1.5rem;
  padding: 1.75rem;
  box-shadow: 0 4px 20px rgba(0,0,0,0.3), inset 0 0 0 1px rgba(255,255,255,0.03);
  transition: transform 0.6s cubic-bezier(0.16,1,0.3,1);
}
.home-stats-card:hover {
  animation-play-state: paused;
  transform: translateY(-4px);
  border-color: rgba(200,182,142,0.12);
  box-shadow: 0 8px 30px rgba(0,0,0,0.4), inset 0 0 0 1px rgba(200,182,142,0.06);
}

.home-stats-card {
  animation: statsFloat 6s ease-in-out infinite;
}

@keyframes statsFloat {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-6px); }
}

.home-stats-label {
  font-size: 0.6rem;
  font-weight: 600;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: rgba(168, 175, 186, 0.5);
  margin-bottom: 0.4rem;
}

.home-stats-number {
  font-family: var(--font-mono);
  font-size: 1.75rem;
  font-weight: 700;
  color: rgba(200, 182, 142, 0.85);
  line-height: 1.1;
  margin-bottom: 0.5rem;
}

.home-stats-bar {
  height: 2px;
  background: linear-gradient(90deg, rgba(200,182,142,0.3), rgba(200,182,142,0.05));
  border-radius: 1px;
}

.home-stats-streak {
  margin-top: 1.25rem;
  font-size: 0.7rem;
  color: rgba(168, 175, 186, 0.35);
  text-align: center;
  font-family: var(--font-serif);
}

@keyframes heroFadeIn {
  from { opacity: 0; transform: translateY(12px); }
  to { opacity: 1; transform: translateY(0); }
}

@media (max-width: 900px) {
  .home-hero-inner {
    flex-direction: column;
    gap: 2.5rem;
    min-height: auto;
  }
  .home-hero-stats {
    width: 100%;
    max-width: 360px;
  }
  .home-focus-row {
    flex-direction: column;
  }
}

@media (max-width: 768px) {
  .home-hero { padding: 2rem 1.25rem 3rem; }
  .home-hero-title {
    font-size: clamp(2rem, 8vw, 2.8rem);
  }
}
</style>
