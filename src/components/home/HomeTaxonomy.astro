---
interface Props {
  categories: { name: string; count: number }[];
  tags: string[];
}

const { categories, tags } = Astro.props;
const sortedCategories = [...categories].sort((a, b) => b.count - a.count);
---

<section class="home-tax">
  <div class="home-tax-inner">
    {sortedCategories.length > 0 && (
      <div class="home-tax-group">
        <span class="home-tax-label">分类</span>
        <div class="home-tax-items">
          {sortedCategories.map((cat) => (
            <a href={`${import.meta.env.BASE_URL}blog/?category=${encodeURIComponent(cat.name)}`}
              class="home-tax-chip">
              {cat.name}
              <span>{cat.count}</span>
            </a>
          ))}
        </div>
      </div>
    )}
    {tags.length > 0 && (
      <div class="home-tax-group">
        <span class="home-tax-label">标签</span>
        <div class="home-tax-items">
          {tags.slice(0, 20).map((tag) => (
            <a href={`${import.meta.env.BASE_URL}tag/${tag}/`}
              class="home-tax-tag">
              #{tag}
            </a>
          ))}
        </div>
      </div>
    )}
  </div>
</section>

<style>
.home-tax {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 2rem 4rem;
}

.home-tax-inner {
  position: relative;
  display: grid;
  grid-template-columns: minmax(220px, 0.75fr) minmax(0, 1.25fr);
  gap: 2rem;
  padding: 2.25rem 2.5rem;
  border: 1px solid rgba(122,149,175,0.13);
  border-radius: 1.5rem;
  background:
    linear-gradient(135deg, rgba(7, 12, 18, 0.64), rgba(10, 14, 22, 0.34)),
    radial-gradient(circle at 8% 12%, rgba(122,149,175,0.08), transparent 42%);
  backdrop-filter: blur(4px) saturate(110%);
  -webkit-backdrop-filter: blur(4px) saturate(110%);
  box-shadow: 0 14px 44px rgba(0,0,0,0.28), inset 0 1px 0 rgba(255,255,255,0.035);
}

.home-tax-group {
  display: block;
  padding: 0;
}
.home-tax-group + .home-tax-group {
  border-left: 1px solid rgba(122,149,175,0.10);
  padding-left: 2rem;
}

.home-tax-label {
  display: block;
  font-size: 0.62rem;
  font-weight: 600;
  letter-spacing: 0.24em;
  text-transform: uppercase;
  color: rgba(168, 175, 186, 0.62);
  margin-bottom: 1rem;
}

.home-tax-items {
  display: flex;
  flex-wrap: wrap;
  gap: 0.4rem;
}

.home-tax-chip {
  display: inline-flex;
  align-items: center;
  gap: 0.45rem;
  padding: 0.52rem 0.95rem;
  font-size: 0.78rem;
  font-family: var(--font-serif);
  color: rgba(214, 218, 225, 0.76);
  border: 1px solid rgba(122,149,175,0.12);
  border-radius: 9999px;
  text-decoration: none;
  transition: all 0.35s cubic-bezier(0.16,1,0.3,1);
  background: rgba(122,149,175,0.035);
}
.home-tax-chip:hover {
  border-color: rgba(200,182,142,0.2);
  color: var(--color-text);
  background: linear-gradient(135deg, rgba(200,182,142,0.08), rgba(122,149,175,0.04));
  transform: translateY(-1px);
  box-shadow: 0 2px 8px rgba(0,0,0,0.15);
}
.home-tax-chip span:last-child {
  font-size: 0.6rem;
  opacity: 0.3;
}

.home-tax-tag {
  display: inline-block;
  padding: 0.32rem 0.7rem;
  font-size: 0.7rem;
  color: rgba(168, 175, 186, 0.56);
  border: 1px solid rgba(255,255,255,0.045);
  border-radius: 0.55rem;
  text-decoration: none;
  transition: all 0.35s cubic-bezier(0.16,1,0.3,1);
  background: rgba(255,255,255,0.018);
}
.home-tax-tag:hover {
  color: var(--color-accent);
  border-color: rgba(200,182,142,0.15);
  background: rgba(200,182,142,0.04);
  transform: translateY(-1px);
}

@media (max-width: 768px) {
  .home-tax { padding-left: 1.25rem; padding-right: 1.25rem; }
  .home-tax-inner {
    grid-template-columns: 1fr;
    padding: 1.75rem;
  }
  .home-tax-group + .home-tax-group {
    border-left: 0;
    border-top: 1px solid rgba(122,149,175,0.10);
    padding-left: 0;
    padding-top: 1.5rem;
  }
}
</style>
