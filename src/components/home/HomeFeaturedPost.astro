---
interface Props {
  post: {
    id: string;
    data: {
      title: string;
      description: string;
      category: string;
      pubDate: Date;
    };
  };
}

const { post } = Astro.props;
---

<section class="home-featured">
  <a href={`${import.meta.env.BASE_URL}blog/${post.id}/`} class="home-featured-link">
    <div class="home-featured-bg">
      <div class="home-featured-visual" aria-hidden="true"></div>
      <div class="home-featured-overlay"></div>
      <div class="home-featured-content">
        <span class="home-featured-label">Cover story</span>
        <span class="home-featured-kicker">精选文章</span>
        <h2 class="home-featured-title">{post.data.title}</h2>
        <p class="home-featured-desc">{post.data.description}</p>
        <div class="home-featured-meta">
          <span class="seal">{post.data.category}</span>
          <time class="home-featured-time">{post.data.pubDate.toLocaleDateString('zh-CN', { year: 'numeric', month: 'short', day: 'numeric' })}</time>
        </div>
      </div>
    </div>
  </a>
</section>

<style>
.home-featured {
  position: relative;
  width: 100%;
  padding: 0 2rem 4rem;
}

.home-featured-link {
  display: block;
  text-decoration: none;
  max-width: 1200px;
  margin: 0 auto;
}

.home-featured-bg {
  position: relative;
  min-height: 460px;
  border-radius: 2rem;
  overflow: hidden;
  background:
    linear-gradient(145deg, rgba(32, 45, 68, 0.64), rgba(6, 10, 18, 0.42)),
    radial-gradient(circle at 74% 18%, rgba(226, 238, 248, 0.16), transparent 34%),
    radial-gradient(circle at 20% 92%, rgba(200, 142, 82, 0.12), transparent 42%);
  backdrop-filter: blur(var(--glass-blur-strong)) saturate(var(--glass-saturate));
  -webkit-backdrop-filter: blur(var(--glass-blur-strong)) saturate(var(--glass-saturate));
  background-size: cover;
  background-position: center;
  border: 1px solid var(--border-glass-strong);
  transition: transform 0.6s cubic-bezier(0.16,1,0.3,1), border-color 0.6s, box-shadow 0.6s;
  box-shadow: 0 36px 100px rgba(0,0,0,0.58), var(--glass-rim-strong), 0 0 80px rgba(122,149,175,0.12);
}

.home-featured-bg::before,
.home-featured-bg::after {
  content: "";
  position: absolute;
  pointer-events: none;
}

.home-featured-bg::before {
  inset: 1px;
  border-radius: calc(2rem - 1px);
  border: 1px solid rgba(226, 238, 248, 0.11);
  box-shadow: inset 0 1px 0 rgba(255,255,255,0.18);
}

.home-featured-bg::after {
  right: -10%;
  top: -28%;
  width: 48%;
  height: 150%;
  background: linear-gradient(140deg, transparent 12%, rgba(122,149,175,0.11), rgba(200,182,142,0.05), transparent 72%);
  transform: rotate(12deg);
  opacity: 0.8;
}
.home-featured-bg:hover,
.home-featured-link:focus-visible .home-featured-bg {
  transform: translateY(-4px);
  border-color: var(--border-warm);
  box-shadow: 0 42px 120px rgba(0,0,0,0.64), var(--glow-warm), var(--glass-rim-strong);
}

.home-featured-visual {
  position: absolute;
  right: 3rem;
  top: 50%;
  width: min(32rem, 48%);
  height: 70%;
  transform: translateY(-50%);
  border-radius: 45% 55% 48% 52%;
  background:
    radial-gradient(circle at 38% 34%, rgba(200,182,142,0.10), transparent 28%),
    radial-gradient(circle at 64% 58%, rgba(122,149,175,0.14), transparent 42%),
    repeating-linear-gradient(135deg, rgba(250,250,249,0.025) 0 1px, transparent 1px 16px);
  border: 1px solid rgba(122,149,175,0.10);
  opacity: 0.78;
}

.home-featured-overlay {
  position: absolute;
  inset: 0;
  background:
    radial-gradient(ellipse 50% 80% at 20% 50%, rgba(200,182,142,0.05) 0%, transparent 60%),
    radial-gradient(ellipse 40% 60% at 80% 30%, rgba(122,149,175,0.04) 0%, transparent 50%);
  pointer-events: none;
}

.home-featured-content {
  position: relative;
  padding: 4.5rem 4rem;
  max-width: 660px;
  z-index: 1;
}

.home-featured-label {
  display: block;
  width: max-content;
  margin-bottom: 0.8rem;
  padding: 0.28rem 0.7rem;
  border: 1px solid rgba(200,182,142,0.14);
  border-radius: 999px;
  font-family: var(--font-mono);
  font-size: 0.58rem;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: rgba(200,182,142,0.72);
  background: rgba(200,182,142,0.045);
}

.home-featured-kicker {
  font-size: 0.6rem;
  font-weight: 600;
  letter-spacing: 0.3em;
  text-transform: uppercase;
  color: rgba(122, 149, 175, 0.72);
  display: inline-block;
  margin-bottom: 1.25rem;
}

.home-featured-title {
  font-family: var(--font-display);
  font-size: clamp(1.9rem, 3.8vw, 3.2rem);
  font-weight: 700;
  color: var(--color-text);
  line-height: 1.12;
  margin-bottom: 0.9rem;
}

.home-featured-desc {
  font-family: var(--font-serif);
  font-size: 0.9rem;
  line-height: 1.8;
  color: rgba(214, 218, 225, 0.74);
  margin-bottom: 1.5rem;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.home-featured-meta {
  display: flex;
  align-items: center;
  gap: 0.75rem;
}

.home-featured-time {
  font-size: 0.75rem;
  color: rgba(168, 175, 186, 0.62);
  font-family: var(--font-mono);
}

@media (max-width: 900px) {
  .home-featured-content {
    padding: 3rem 1.75rem;
  }
  .home-featured-visual {
    right: -5rem;
    width: 18rem;
    opacity: 0.45;
  }
}

@media (max-width: 768px) {
  .home-featured { padding: 0 1.25rem 3rem; }
}
</style>
