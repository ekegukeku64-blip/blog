---
import PostCard from '../PostCard.astro';
import { calcReadingTime } from '../../utils/readingTime';

interface Props {
  posts: {
    id: string;
    body?: string;
    data: {
      title: string;
      description: string;
      pubDate: Date;
      tags: string[];
      category: string;
    };
  }[];
}

const { posts } = Astro.props;
---

<section class="home-posts">
  <div class="home-posts-header">
    <h2 class="section-kicker">最新文章</h2>
    <a href={`${import.meta.env.BASE_URL}blog/`} class="home-posts-all">
      查看全部 &rarr;
    </a>
  </div>

  {posts.length > 0 ? (
    <div class="home-grid-2col">
      {posts.map((post, i) => (
        <div class="reveal-target" style={`transition-delay: ${(i * 0.04).toFixed(2)}s`}>
          <PostCard
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            tags={post.data.tags}
            category={post.data.category}
            slug={post.id}
            readingTime={calcReadingTime(post.body || '')}
            featured={false}
          />
        </div>
      ))}
    </div>
  ) : (
    <div class="home-empty">
      <p class="text-lg mb-2 font-serif">还没有文章</p>
      <p class="text-sm">在 <code class="px-2 py-0.5 bg-surface-alt rounded text-xs">src/content/posts/</code> 目录下添加 Markdown 文件即可</p>
    </div>
  )}
</section>

<style>
.home-posts {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 2rem 3rem;
}

.home-posts-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 2rem;
}

.home-posts-all {
  font-size: 0.8rem;
  color: rgba(122, 149, 175, 0.7);
  text-decoration: none;
  font-family: var(--font-serif);
  transition: color 0.3s;
}
.home-posts-all:hover {
  color: var(--color-accent);
}

.home-grid-2col {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 1.25rem;
}

.home-empty {
  text-align: center;
  padding: 5rem 2rem;
  color: var(--color-text-muted);
}

@media (max-width: 900px) {
  .home-grid-2col {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 768px) {
  .home-grid-2col { grid-template-columns: 1fr; }
  .home-posts { padding-left: 1.25rem; padding-right: 1.25rem; }
}
</style>
