<section class="home-daily reveal-target">
  <div class="home-daily-inner">
    <div class="flex items-center justify-between mb-8">
      <h2 class="section-kicker">技术日报</h2>
      <a href="https://ekegukeku64-blip.github.io/tech-daily/" target="_blank" rel="noopener" class="home-posts-all">
        查看全部 &rarr;
      </a>
    </div>
    <div id="tech-daily-grid" class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="col-span-3 text-center py-8 text-sm text-text-muted/50 font-serif">加载中...</div>
    </div>
  </div>
</section>

<script is:inline>
document.addEventListener('astro:page-load', async () => {
  const grid = document.getElementById('tech-daily-grid');
  if (!grid) return;
  try {
    const resp = await fetch('https://ekegukeku64-blip.github.io/tech-daily/sitemap-0.xml');
    const xml = await resp.text();
    const matches = [...xml.matchAll(/<loc>(https:\/\/[^<]*daily-tech-(\d{4}-\d{2}-\d{2})[^<]*)<\/loc>/g)];
    matches.sort((a, b) => b[2].localeCompare(a[2]));
    const links = matches.slice(0, 3).map(m => ({ url: m[1], date: m[2] }));
    if (links.length === 0) {
      grid.innerHTML = '<div class="col-span-3 text-center py-8 text-sm text-text-muted/50 font-serif">暂无内容</div>';
      return;
    }
    grid.textContent = '';
    const fragment = document.createDocumentFragment();
    const shouldReduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    links.forEach(({ url, date }) => {
      const wrapper = document.createElement('div');
      wrapper.className = 'card-tilt-wrapper';

      const link = document.createElement('a');
      link.href = url;
      link.target = '_blank';
      link.rel = 'noopener';
      link.className = 'card card-tilt group block p-5';

      const spotlight = document.createElement('div');
      spotlight.className = 'card-tilt-spotlight';
      spotlight.setAttribute('aria-hidden', 'true');

      const time = document.createElement('time');
      time.className = 'text-[11px] text-text-secondary font-mono';
      time.textContent = date;

      const title = document.createElement('h3');
      title.className = 'mt-2 font-display text-base font-bold text-text leading-snug group-hover:text-accent transition-colors duration-200';
      title.textContent = `技术日报 · ${date.slice(5)}`;

      const desc = document.createElement('p');
      desc.className = 'mt-1.5 text-sm text-text-secondary line-clamp-2 leading-relaxed';
      desc.textContent = 'GitHub 热门项目 + HN 技术圈每日动态';

      link.append(spotlight, time, title, desc);
      wrapper.append(link);
      fragment.append(wrapper);
    });
    grid.append(fragment);
    if (!shouldReduceMotion) {
      document.querySelectorAll('#tech-daily-grid .card-tilt-wrapper').forEach(initTiltDaily);
    }
  } catch {
    grid.innerHTML = '<div class="col-span-3 text-center py-8 text-sm text-text-muted/50 font-serif">日报暂不可用</div>';
  }
});

const MAX_TILT_DAILY = 3.0;
function initTiltDaily(wrapper) {
  const card = wrapper.querySelector('.card-tilt');
  if (!card) return;
  wrapper.style.perspective = '800px';
  wrapper.addEventListener('mousemove', (e) => {
    const rect = wrapper.getBoundingClientRect();
    const x = (e.clientX - rect.left) / rect.width;
    const y = (e.clientY - rect.top) / rect.height;
    const tiltX = (y - 0.5) * 2 * MAX_TILT_DAILY;
    const tiltY = (x - 0.5) * -2 * MAX_TILT_DAILY;
    card.style.transform = `rotateX(${tiltX}deg) rotateY(${tiltY}deg) translateY(${-((1 - Math.min(Math.hypot(x-0.5, y-0.5) * 1.4, 1)) * 10)}px)`;
  });
  wrapper.addEventListener('mouseleave', () => {
    card.style.transform = '';
  });
}
</script>

<style>
.home-daily {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 2rem 4rem;
}

.home-daily-inner {
  padding: 2.25rem 2.5rem;
  border: 1px solid rgba(122,149,175,0.13);
  border-radius: 1.5rem;
  background:
    linear-gradient(135deg, rgba(7, 12, 18, 0.64), rgba(10, 14, 22, 0.34)),
    radial-gradient(circle at 92% 12%, rgba(200,182,142,0.06), transparent 42%);
  backdrop-filter: blur(4px) saturate(110%);
  -webkit-backdrop-filter: blur(4px) saturate(110%);
  box-shadow: 0 14px 44px rgba(0,0,0,0.28), inset 0 1px 0 rgba(255,255,255,0.035);
}

.home-posts-all {
  font-size: 0.8rem;
  color: rgba(122, 149, 175, 0.7);
  text-decoration: none;
  font-family: var(--font-serif);
  transition: color 0.3s;
}
.home-posts-all:hover,
.home-posts-all:focus-visible {
  color: var(--color-accent);
}

@media (max-width: 768px) {
  .home-daily { padding-left: 1.25rem; padding-right: 1.25rem; }
}
</style>
