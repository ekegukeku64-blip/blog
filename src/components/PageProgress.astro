---
// 页面加载进度条 — 顶部细线
---

<div id="page-progress" class="fixed top-0 left-0 w-full h-0.5 z-[9999] pointer-events-none">
  <div id="page-progress-bar" class="h-full bg-accent dark:bg-dark-accent transition-all duration-200 ease-out" style="width: 0%"></div>
</div>

<script is:inline>
  let ppTimer = null;
  document.addEventListener('astro:page-load', () => {
    const bar = document.getElementById('page-progress-bar');
    if (!bar) return;

    clearTimeout(ppTimer);
    bar.style.opacity = '1';
    // 先重置到0再开始动画，防止遗留上次的宽度
    bar.style.transition = 'none';
    bar.style.width = '0%';
    requestAnimationFrame(() => {
      bar.style.transition = 'width 0.2s ease-out';
      bar.style.width = '30%';
      ppTimer = setTimeout(() => { bar.style.width = '70%'; }, 100);
      ppTimer = setTimeout(() => { bar.style.width = '100%'; }, 300);
      ppTimer = setTimeout(() => { bar.style.opacity = '0'; }, 500);
      ppTimer = setTimeout(() => { bar.style.width = '0%'; bar.style.opacity = '1'; }, 700);
    });
  });
</script>
