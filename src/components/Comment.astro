---
// 评论组件 — Firestore 实时评论，需登录
---

<div class="mt-10">
  <div class="flex items-end gap-4 mb-8 border-b border-border/40 dark:border-dark-border/40 pb-4">
    <h3 class="font-display text-xl font-bold text-text dark:text-dark-text">留言</h3>
    <p id="comment-count" class="text-xs text-text-muted dark:text-dark-text-muted ml-auto font-sans"></p>
  </div>

  <!-- 未登录提示 -->
  <div id="comment-auth-prompt" class="mb-10 text-center py-8 border border-dashed border-border/40 dark:border-dark-border/40 rounded-xl">
    <svg class="w-10 h-10 mx-auto mb-3 text-text-muted dark:text-dark-text-muted" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
      <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
    </svg>
    <p class="text-sm text-text-muted dark:text-dark-text-muted mb-3">登录后即可留言</p>
    <div class="flex justify-center gap-3">
      <button id="comment-login-google" class="px-4 py-2 text-sm rounded-lg bg-surface-alt dark:bg-dark-surface-alt text-text dark:text-dark-text hover:bg-accent/10 dark:hover:bg-dark-accent/10 transition-colors">
        Google 登录
      </button>
      <button id="comment-login-github" class="px-4 py-2 text-sm rounded-lg bg-surface-alt dark:bg-dark-surface-alt text-text dark:text-dark-text hover:bg-accent/10 dark:hover:bg-dark-accent/10 transition-colors">
        GitHub 登录
      </button>
    </div>
    <p id="comment-auth-status" class="mt-3 text-sm text-red-500 hidden" role="status" aria-live="polite"></p>
  </div>

  <!-- 已登录：留言表单 -->
  <form id="comment-form" class="mb-10 space-y-4 hidden">
    <div class="flex items-center gap-3 mb-2">
      <img id="comment-user-avatar" class="w-8 h-8 rounded-full" src="" alt="当前登录用户头像" />
      <span id="comment-user-name" class="text-sm font-medium text-text dark:text-dark-text"></span>
    </div>
    <label for="comment-content" class="sr-only">留言内容</label>
    <textarea id="comment-content" placeholder="说点什么..." required maxlength="2000" rows="4"
      class="comment-input px-4 py-3 rounded-xl text-sm w-full resize-y"></textarea>
    <div class="flex items-center justify-between">
      <p id="comment-submit-status" class="text-xs text-text-muted dark:text-dark-text-muted font-sans" role="status" aria-live="polite">评论提交后会先进入审核</p>
      <button type="submit" id="comment-submit-btn"
        class="comment-submit px-6 py-2.5 rounded-xl text-sm font-sans font-medium cursor-pointer transition-all duration-300 hover:shadow-lg hover:shadow-accent/20 dark:hover:shadow-dark-accent/20">
        发送
      </button>
    </div>
  </form>

  <!-- 评论列表 -->
  <div id="comment-list" class="space-y-6">
    <p class="comment-empty">加载中...</p>
  </div>
</div>

<style>
  .comment-input {
    font-family: var(--font-sans);
    background: var(--color-surface-alt);
    color: var(--color-text);
    border: 1px solid var(--color-border);
    transition: border-color 0.2s;
  }
  .comment-input::placeholder {
    color: var(--color-text-muted);
  }
  .comment-input:focus {
    outline: none;
    border-color: var(--color-accent);
  }
  :root.dark .comment-input {
    background: var(--color-dark-surface-alt);
    color: var(--color-dark-text);
    border-color: var(--color-dark-border);
  }
  :root.dark .comment-input::placeholder {
    color: var(--color-dark-text-muted);
  }
  :root.dark .comment-input:focus {
    border-color: var(--color-dark-accent);
  }

  .comment-submit {
    background: var(--color-accent);
    color: white;
  }
  .comment-submit:hover {
    opacity: 0.85;
  }
  :root.dark .comment-submit {
    background: var(--color-dark-accent);
    color: var(--color-dark-surface);
  }

  .comment-item {
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--color-border);
  }
  :root.dark .comment-item {
    border-bottom-color: var(--color-dark-border);
  }
  .comment-item:last-child {
    border-bottom: none;
  }
  .comment-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
  }
  .comment-avatar {
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    overflow: hidden;
    flex-shrink: 0;
    background: var(--color-accent);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .comment-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .comment-avatar-fallback {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-accent);
    color: white;
    font-size: 0.75rem;
    font-weight: 600;
    font-family: var(--font-sans);
  }
  :root.dark .comment-avatar-fallback {
    background: var(--color-dark-accent);
    color: var(--color-dark-surface);
  }
  .comment-author {
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: 0.9rem;
    color: var(--color-text);
  }
  :root.dark .comment-author {
    color: var(--color-dark-text);
  }
  .comment-time {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }
  :root.dark .comment-time {
    color: var(--color-dark-text-muted);
  }
  .comment-body {
    font-family: var(--font-serif);
    font-size: 0.95rem;
    line-height: 1.7;
    color: var(--color-text);
    padding-left: 2.75rem;
  }
  :root.dark .comment-body {
    color: var(--color-dark-text);
  }
  .comment-delete {
    padding-left: 2.75rem;
    margin-top: 0.25rem;
  }
  .comment-delete button {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    cursor: pointer;
    transition: color 0.2s;
  }
  .comment-delete button:hover {
    color: #ef4444;
  }

  .comment-empty {
    text-align: center;
    padding: 2rem 0;
    color: var(--color-text-muted);
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 0.9rem;
  }
  :root.dark .comment-empty {
    color: var(--color-dark-text-muted);
  }
  .comment-retry {
    min-height: 2.75rem;
    margin-top: 0.75rem;
    padding: 0.55rem 1rem;
    border: 1px solid var(--border-glass-strong);
    border-radius: 0.5rem;
    color: var(--color-text-secondary);
    background: rgba(255, 255, 255, 0.04);
    font-family: var(--font-sans);
    font-size: 0.8rem;
    cursor: pointer;
  }
  .comment-retry:hover,
  .comment-retry:focus-visible {
    color: var(--color-text);
    border-color: var(--border-warm);
    outline: none;
  }
</style>

<script>
  import {
    isFirebaseConfigured, onAuth, loginWithGoogle, loginWithGithub,
    db, collection, addDoc, query, where,
    onSnapshot, doc, deleteDoc, serverTimestamp,
    type Comment, type User,
  } from '../lib/firebase'

  declare global {
    interface Window {
      __commentCleanup?: () => void
    }
  }

  let pageId = window.location.pathname
  let currentUser: User | null = null
  let unsubscribe: (() => void) | null = null
  let authUnsubscribe: (() => void) | null = null

  function formatCommentTime(ts: Comment['createdAt']) {
    if (!ts) return ''
    const d = ts.toDate()
    return d.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' })
  }

  function escapeHtml(value: unknown) {
    const div = document.createElement('div')
    div.textContent = String(value ?? '')
    return div.innerHTML
  }

  function safeImageUrl(value: unknown) {
    if (typeof value !== 'string' || !value.trim()) return ''
    try {
      const url = new URL(value)
      return url.protocol === 'https:' || url.protocol === 'http:' ? url.toString() : ''
    } catch {
      return ''
    }
  }

  function renderComments(list: HTMLElement, comments: Comment[]) {
    const count = document.getElementById('comment-count')
    if (count) count.textContent = comments.length > 0 ? `${comments.length} 条留言` : ''

    if (comments.length === 0) {
      list.innerHTML = '<p class="comment-empty">还没有留言，来做第一个吧</p>'
      return
    }

    list.innerHTML = comments.map(c => {
      const photoURL = safeImageUrl(c.photoURL)
      const avatarHtml = photoURL
        ? `<img src="${escapeHtml(photoURL)}" alt="${escapeHtml(c.displayName)}" loading="lazy" decoding="async" referrerpolicy="no-referrer" />`
        : `<div class="comment-avatar-fallback">${escapeHtml(c.displayName).charAt(0).toUpperCase()}</div>`
      const deleteBtn = currentUser && currentUser.uid === c.uid
        ? `<div class="comment-delete"><button data-id="${escapeHtml(c.id)}">删除</button></div>`
        : ''
      return `
        <div class="comment-item">
          <div class="comment-meta">
            <div class="comment-avatar">${avatarHtml}</div>
            <span class="comment-author">${escapeHtml(c.displayName)}</span>
            <span class="comment-time">${formatCommentTime(c.createdAt)}</span>
          </div>
          <div class="comment-body">${escapeHtml(c.content).replace(/\n/g, '<br>')}</div>
          ${deleteBtn}
        </div>
      `
    }).join('')

    // 删除按钮事件
    list.querySelectorAll('.comment-delete button').forEach(btn => {
      btn.addEventListener('click', async () => {
        const id = btn.getAttribute('data-id')
        if (id && confirm('确定删除这条评论？')) {
          await deleteDoc(doc(db!, 'comments', id))
        }
      })
    })
  }

  function subscribeComments(list: HTMLElement) {
    if (unsubscribe) unsubscribe()
    const q = query(
      collection(db!, 'comments'),
      where('pageId', '==', pageId),
      where('status', '==', 'approved')
    )
    unsubscribe = onSnapshot(q, (snapshot) => {
      const comments = snapshot.docs
        .map(d => ({ id: d.id, ...d.data() } as Comment))
        .sort((a, b) => (b.createdAt?.toMillis?.() || 0) - (a.createdAt?.toMillis?.() || 0))
      renderComments(list, comments)
    }, (error) => {
      const log = error?.code === 'permission-denied' ? console.warn : console.error
      log('Comments subscription error:', error)
      list.innerHTML =
        '<div class="comment-empty">' +
          '<p>留言暂时没有加载出来</p>' +
          '<button id="comment-retry" class="comment-retry" type="button">重新加载</button>' +
        '</div>'
      document.getElementById('comment-retry')?.addEventListener('click', () => subscribeComments(list), { once: true })
    })
  }

  document.addEventListener('astro:page-load', () => {
    window.__commentCleanup?.()
    const controller = new AbortController()
    pageId = window.location.pathname
    authUnsubscribe?.()
    authUnsubscribe = null
    const form = document.getElementById('comment-form')
    const list = document.getElementById('comment-list')
    const authPrompt = document.getElementById('comment-auth-prompt')
    const userAvatar = document.getElementById('comment-user-avatar') as HTMLImageElement | null
    const userName = document.getElementById('comment-user-name')
    const loginGoogle = document.getElementById('comment-login-google')
    const loginGithub = document.getElementById('comment-login-github')
    const submitStatus = document.getElementById('comment-submit-status')
    const authStatus = document.getElementById('comment-auth-status')

    if (!form || !list) return
    const setAuthStatus = (message: string) => {
      if (!authStatus) return
      authStatus.textContent = message
      authStatus.classList.toggle('hidden', !message)
    }
    if (!isFirebaseConfigured || !db) {
      authPrompt?.classList.add('hidden')
      list.innerHTML = '<p class="comment-empty" role="status">留言功能暂未配置</p>'
      return
    }



    // 登录按钮
    loginGoogle?.addEventListener('click', async () => {
      try { setAuthStatus(''); await loginWithGoogle() } catch (e) { console.error(e); setAuthStatus('登录失败，请检查弹窗或浏览器拦截设置。') }
    }, { signal: controller.signal })
    loginGithub?.addEventListener('click', async () => {
      try { setAuthStatus(''); await loginWithGithub() } catch (e) { console.error(e); setAuthStatus('登录失败，请检查弹窗或浏览器拦截设置。') }
    }, { signal: controller.signal })

    // 认证状态
    authUnsubscribe = onAuth((user) => {
      currentUser = user
      if (user) {
        form.classList.remove('hidden')
        authPrompt?.classList.add('hidden')
        const avatarUrl = safeImageUrl(user.photoURL)
        if (userAvatar) {
          userAvatar.src = avatarUrl
          userAvatar.classList.toggle('hidden', !avatarUrl)
        }
        if (userName) userName.textContent = user.displayName || user.email || '用户'
        setAuthStatus('')
      } else {
        form.classList.add('hidden')
        authPrompt?.classList.remove('hidden')
      }
      subscribeComments(list)
    })

    // 提交评论
    form.addEventListener('submit', async (e) => {
      e.preventDefault()
      if (!currentUser) return
      const textarea = document.getElementById('comment-content') as HTMLTextAreaElement | null
      const content = textarea?.value.trim().slice(0, 2000)
      if (!content) return
      const submitBtn = document.getElementById('comment-submit-btn') as HTMLButtonElement | null
      if (submitBtn) {
        submitBtn.disabled = true
        submitBtn.textContent = '正在提交...'
      }

      try {
        if (submitStatus) submitStatus.textContent = '正在提交...'
        await addDoc(collection(db!, 'comments'), {
          pageId,
          uid: currentUser.uid,
          displayName: String(currentUser.displayName || currentUser.email || '匿名').slice(0, 200),
          photoURL: safeImageUrl(currentUser.photoURL),
          content,
          status: 'pending',
          createdAt: serverTimestamp(),
        })
        if (textarea) textarea.value = ''
        if (submitStatus) submitStatus.textContent = '已提交，审核通过后会显示'
      } catch (e) {
        console.error('Failed to post comment:', e)
        if (submitStatus) submitStatus.textContent = '提交失败，请重试'
      } finally {
        if (submitBtn) {
          submitBtn.disabled = false
          submitBtn.textContent = '发送'
        }
      }
    }, { signal: controller.signal })
    window.__commentCleanup = () => {
      controller.abort()
      authUnsubscribe?.()
      authUnsubscribe = null
      unsubscribe?.()
      unsubscribe = null
      currentUser = null
    }
  })
  document.addEventListener('astro:before-swap', () => window.__commentCleanup?.())
</script>
