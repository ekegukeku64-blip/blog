---
// 评论组件 — Firestore 实时评论，需登录
---

<div class="mt-10">
  <div class="flex items-end gap-4 mb-8 border-b border-border/40 dark:border-dark-border/40 pb-4">
    <h3 class="font-display text-xl font-bold text-text dark:text-dark-text">留言</h3>
    <p id="comment-count" class="text-xs text-text-muted dark:text-dark-text-muted ml-auto font-sans"></p>
  </div>

  <!-- 未登录提示 -->
  <div id="comment-auth-prompt" class="mb-10 text-center py-8 border border-dashed border-border/40 dark:border-dark-border/40 rounded-xl">
    <svg class="w-10 h-10 mx-auto mb-3 text-text-muted dark:text-dark-text-muted" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
      <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
    </svg>
    <p class="text-sm text-text-muted dark:text-dark-text-muted mb-3">登录后即可留言</p>
    <div class="flex justify-center gap-3">
      <button id="comment-login-google" class="px-4 py-2 text-sm rounded-lg bg-surface-alt dark:bg-dark-surface-alt text-text dark:text-dark-text hover:bg-accent/10 dark:hover:bg-dark-accent/10 transition-colors">
        Google 登录
      </button>
      <button id="comment-login-github" class="px-4 py-2 text-sm rounded-lg bg-surface-alt dark:bg-dark-surface-alt text-text dark:text-dark-text hover:bg-accent/10 dark:hover:bg-dark-accent/10 transition-colors">
        GitHub 登录
      </button>
    </div>
  </div>

  <!-- 已登录：留言表单 -->
  <form id="comment-form" class="mb-10 space-y-4 hidden">
    <div class="flex items-center gap-3 mb-2">
      <img id="comment-user-avatar" class="w-8 h-8 rounded-full" src="" alt="" />
      <span id="comment-user-name" class="text-sm font-medium text-text dark:text-dark-text"></span>
    </div>
    <textarea id="comment-content" placeholder="说点什么..." required rows="4"
      class="comment-input px-4 py-3 rounded-xl text-sm w-full resize-y"></textarea>
    <div class="flex items-center justify-between">
      <p class="text-xs text-text-muted dark:text-dark-text-muted font-sans">
        评论会实时显示在页面上
      </p>
      <button type="submit"
        class="comment-submit px-6 py-2.5 rounded-xl text-sm font-sans font-medium cursor-pointer transition-all duration-300 hover:shadow-lg hover:shadow-accent/20 dark:hover:shadow-dark-accent/20">
        发送
      </button>
    </div>
  </form>

  <!-- 评论列表 -->
  <div id="comment-list" class="space-y-6">
    <p class="comment-empty">加载中...</p>
  </div>
</div>

<style>
  .comment-input {
    font-family: var(--font-sans);
    background: var(--color-surface-alt);
    color: var(--color-text);
    border: 1px solid var(--color-border);
    transition: border-color 0.2s;
  }
  .comment-input::placeholder {
    color: var(--color-text-muted);
  }
  .comment-input:focus {
    outline: none;
    border-color: var(--color-accent);
  }
  :root.dark .comment-input {
    background: var(--color-dark-surface-alt);
    color: var(--color-dark-text);
    border-color: var(--color-dark-border);
  }
  :root.dark .comment-input::placeholder {
    color: var(--color-dark-text-muted);
  }
  :root.dark .comment-input:focus {
    border-color: var(--color-dark-accent);
  }

  .comment-submit {
    background: var(--color-accent);
    color: white;
  }
  .comment-submit:hover {
    opacity: 0.85;
  }
  :root.dark .comment-submit {
    background: var(--color-dark-accent);
    color: var(--color-dark-surface);
  }

  .comment-item {
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--color-border);
  }
  :root.dark .comment-item {
    border-bottom-color: var(--color-dark-border);
  }
  .comment-item:last-child {
    border-bottom: none;
  }
  .comment-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
  }
  .comment-avatar {
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    overflow: hidden;
    flex-shrink: 0;
    background: var(--color-accent);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .comment-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .comment-avatar-fallback {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-accent);
    color: white;
    font-size: 0.75rem;
    font-weight: 600;
    font-family: var(--font-sans);
  }
  :root.dark .comment-avatar-fallback {
    background: var(--color-dark-accent);
    color: var(--color-dark-surface);
  }
  .comment-author {
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: 0.9rem;
    color: var(--color-text);
  }
  :root.dark .comment-author {
    color: var(--color-dark-text);
  }
  .comment-time {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }
  :root.dark .comment-time {
    color: var(--color-dark-text-muted);
  }
  .comment-body {
    font-family: var(--font-serif);
    font-size: 0.95rem;
    line-height: 1.7;
    color: var(--color-text);
    padding-left: 2.75rem;
  }
  :root.dark .comment-body {
    color: var(--color-dark-text);
  }
  .comment-delete {
    padding-left: 2.75rem;
    margin-top: 0.25rem;
  }
  .comment-delete button {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    cursor: pointer;
    transition: color 0.2s;
  }
  .comment-delete button:hover {
    color: #ef4444;
  }

  .comment-empty {
    text-align: center;
    padding: 2rem 0;
    color: var(--color-text-muted);
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 0.9rem;
  }
  :root.dark .comment-empty {
    color: var(--color-dark-text-muted);
  }
</style>

<script>
  import {
    onAuth, loginWithGoogle, loginWithGithub,
    db, collection, addDoc, query, where, orderBy,
    onSnapshot, doc, deleteDoc, serverTimestamp,
    type Comment,
  } from '../lib/firebase'

  const pageId = window.location.pathname
  let currentUser: any = null
  let unsubscribe: (() => void) | null = null

  function formatDate(ts: any) {
    if (!ts) return ''
    const d = ts.toDate ? ts.toDate() : new Date(ts)
    const now = new Date()
    const diff = now.getTime() - d.getTime()
    if (diff < 60000) return '刚刚'
    if (diff < 3600000) return Math.floor(diff / 60000) + ' 分钟前'
    if (diff < 86400000) return Math.floor(diff / 3600000) + ' 小时前'
    if (diff < 604800000) return Math.floor(diff / 86400000) + ' 天前'
    return d.toLocaleDateString('zh-CN', { month: 'long', day: 'numeric' })
  }

  function escapeHtml(str: string) {
    const div = document.createElement('div')
    div.textContent = str
    return div.innerHTML
  }

  function renderComments(list: HTMLElement, comments: Comment[]) {
    const count = document.getElementById('comment-count')
    if (count) count.textContent = comments.length > 0 ? `${comments.length} 条留言` : ''

    if (comments.length === 0) {
      list.innerHTML = '<p class="comment-empty">还没有留言，来做第一个吧</p>'
      return
    }

    list.innerHTML = comments.map(c => {
      const avatarHtml = c.photoURL
        ? `<img src="${c.photoURL}" alt="${escapeHtml(c.displayName)}" />`
        : `<div class="comment-avatar-fallback">${escapeHtml(c.displayName).charAt(0).toUpperCase()}</div>`
      const deleteBtn = currentUser && currentUser.uid === c.uid
        ? `<div class="comment-delete"><button data-id="${c.id}">删除</button></div>`
        : ''
      return `
        <div class="comment-item">
          <div class="comment-meta">
            <div class="comment-avatar">${avatarHtml}</div>
            <span class="comment-author">${escapeHtml(c.displayName)}</span>
            <span class="comment-time">${formatDate(c.createdAt)}</span>
          </div>
          <div class="comment-body">${escapeHtml(c.content).replace(/\n/g, '<br>')}</div>
          ${deleteBtn}
        </div>
      `
    }).join('')

    // 删除按钮事件
    list.querySelectorAll('.comment-delete button').forEach(btn => {
      btn.addEventListener('click', async () => {
        const id = btn.getAttribute('data-id')
        if (id && confirm('确定删除这条评论？')) {
          await deleteDoc(doc(db, 'comments', id))
        }
      })
    })
  }

  function subscribeComments(list: HTMLElement) {
    if (unsubscribe) unsubscribe()
    const q = query(
      collection(db, 'comments'),
      where('pageId', '==', pageId),
      where('status', '==', 'approved'),
      orderBy('createdAt', 'desc')
    )
    unsubscribe = onSnapshot(q, (snapshot) => {
      const comments = snapshot.docs.map(d => ({ id: d.id, ...d.data() } as Comment))
      renderComments(list, comments)
    }, (error) => {
      console.error('Comments subscription error:', error)
      list.innerHTML = '<p class="comment-empty">评论加载失败，请刷新重试</p>'
    })
  }

  document.addEventListener('astro:page-load', () => {
    const form = document.getElementById('comment-form')
    const list = document.getElementById('comment-list')
    const authPrompt = document.getElementById('comment-auth-prompt')
    const userAvatar = document.getElementById('comment-user-avatar')
    const userName = document.getElementById('comment-user-name')
    const loginGoogle = document.getElementById('comment-login-google')
    const loginGithub = document.getElementById('comment-login-github')

    if (!form || !list) return

    // 登录按钮
    loginGoogle?.addEventListener('click', async () => {
      try { await loginWithGoogle() } catch (e) { console.error(e) }
    })
    loginGithub?.addEventListener('click', async () => {
      try { await loginWithGithub() } catch (e) { console.error(e) }
    })

    // 认证状态
    onAuth((user) => {
      currentUser = user
      if (user) {
        form.classList.remove('hidden')
        authPrompt?.classList.add('hidden')
        if (userAvatar && user.photoURL) userAvatar.src = user.photoURL
        if (userName) userName.textContent = user.displayName || user.email || '用户'
      } else {
        form.classList.add('hidden')
        authPrompt?.classList.remove('hidden')
      }
      subscribeComments(list)
    })

    // 提交评论
    form.addEventListener('submit', async (e) => {
      e.preventDefault()
      if (!currentUser) return
      const textarea = document.getElementById('comment-content')
      const content = textarea.value.trim()
      if (!content) return

      try {
        await addDoc(collection(db, 'comments'), {
          pageId,
          uid: currentUser.uid,
          displayName: currentUser.displayName || currentUser.email || '匿名',
          photoURL: currentUser.photoURL || '',
          content,
          status: 'approved',
          createdAt: serverTimestamp(),
        })
        textarea.value = ''
      } catch (e) {
        console.error('Failed to post comment:', e)
        alert('评论发送失败，请重试')
      }
    })
  })
</script>
