---
import '../styles/global.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/700.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/noto-serif-sc/400.css';
import '@fontsource/noto-serif-sc/600.css';
import '@fontsource/noto-serif-sc/700.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BackToTop from '../components/BackToTop.astro';
import MusicPlayer from '../components/MusicPlayer.astro';
import ReadingProgress from '../components/ReadingProgress.astro';
import PageProgress from '../components/PageProgress.astro';
import Analytics from '../components/Analytics.astro';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const { title, description = '一个关于技术、设计与生活的博客', image } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const isEntrance = Astro.url.pathname === import.meta.env.BASE_URL || Astro.url.pathname === '/';
---
<!doctype html>
<html lang="zh-CN" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="google-site-verification" content="nF43Ycr0M27ASMgp4dtsTYJa9xfQ2mO9lyB1aWs2iYs" />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#070A13" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <link rel="icon" type="image/x-icon" href={`${import.meta.env.BASE_URL}favicon.ico`} />
    <link rel="apple-touch-icon" href={`${import.meta.env.BASE_URL}apple-touch-icon.svg`} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" type="application/rss+xml" title="墨迹博客 RSS" href={new URL('/blog/rss.xml', Astro.site)} />
    <meta property="og:image" content={new URL(image ? `${import.meta.env.BASE_URL}${image.replace(/^\//, '')}` : `${import.meta.env.BASE_URL}hero/og-default.png`, Astro.site)} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="墨迹博客" />
    <meta property="og:locale" content="zh_CN" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(image ? `${import.meta.env.BASE_URL}${image.replace(/^\//, '')}` : `${import.meta.env.BASE_URL}hero/og-default.png`, Astro.site)} />
    <meta name="twitter:site" content="@moku_blog" />
    <meta name="author" content="又逢雨季" />
    <title>{title} | 墨迹博客</title>
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Blog",
        "name": "墨迹博客",
        "description": "一个关于技术、设计与生活的博客",
        "url": "https://ekegukeku64-blip.github.io/blog/",
        "author": { "@type": "Person", "name": "又逢雨季" },
        "inLanguage": "zh-CN"
      }
    </script>
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "WebSite",
        "name": "墨迹博客",
        "url": "https://ekegukeku64-blip.github.io/blog/",
        "potentialAction": {
          "@type": "SearchAction",
          "target": "https://ekegukeku64-blip.github.io/blog/?q={search_term_string}",
          "query-input": "required name=search_term_string"
        }
      }
    </script>
    <script is:inline>
      // 物理锁死深色模式 + ClientRouter 导航后修复 page-entrance class
      function syncPageEntrance() {
        if (!document.body) return;
        const onEntrance = location.pathname === '/blog/' || location.pathname === '/';
        document.body.classList.toggle('page-entrance', onEntrance);
        if (!onEntrance) {
          const gv = document.getElementById('global-bg-video');
          if (gv) gv.play().catch(() => {});
        }
      }
      document.addEventListener('astro:after-swap', () => {
        document.documentElement.classList.add('dark');
        document.documentElement.style.setProperty('background-color', 'transparent', 'important');
        document.documentElement.style.setProperty('color', '#F5F5F4', 'important');
        syncPageEntrance();
      });
      document.documentElement.classList.add('dark');
      if (document.body) syncPageEntrance();
      // 清除旧版 ThemePicker 残留在 localStorage 的暖色
      try { localStorage.removeItem('accent_color'); } catch (_) {}
    </script>
    <ClientRouter />
    <slot name="head" />
  </head>
  <body class={`min-h-screen flex flex-col${isEntrance ? ' page-entrance' : ''}`}>
    <div class="global-bg-layer" aria-hidden="true">
      <img id="global-bg-poster" class="global-bg-video" src={`${import.meta.env.BASE_URL}maple.jpg`} alt="" />
      <video id="global-bg-video" class="global-bg-video"
        poster={`${import.meta.env.BASE_URL}maple.jpg`}
        preload="metadata"
        loop muted playsinline style="display:none">
      </video>
    </div>
    <ReadingProgress />
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
    <BackToTop />
    <MusicPlayer />
    <PageProgress />
    <Analytics />
    <script is:inline>
      { // block scope for is:inline scripts
      // === Background video: lazy load on interaction ===
      const gv = document.getElementById('global-bg-video');
      const poster = document.getElementById('global-bg-poster');
      if (gv && poster) {
        const isMobile = window.matchMedia('(max-width: 768px)').matches;
        if (!isMobile) {
          let loaded = false;
          const loadVideo = () => {
            if (loaded) return;
            loaded = true;
            if (!gv.src) {
              gv.src = '/blog/maple.mp4';
              gv.load();
            }
            gv.play().then(() => {
              poster.style.display = 'none';
              gv.style.display = '';
            }).catch(() => {});
          };
          window.addEventListener('load', () => {
            const trigger = () => { setTimeout(loadVideo, 2000); };
            window.addEventListener('scroll', trigger, { once: true, passive: true });
            document.addEventListener('click', trigger, { once: true });
            setTimeout(() => loadVideo(), 20000);
          });
        }
      }
      } // end block scope
    </script>
    <script is:inline>
      function initReveal() {
        // Unified scroll reveal for both .reveal-target and .blur-reveal
        let staggerIdx = 0;
        let staggerTimer = null;
        const observer = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              const delay = staggerIdx * 60;
              setTimeout(() => {
                entry.target.classList.add('is-revealed');
                if (entry.target.classList.contains('blur-reveal')) {
                  entry.target.classList.add('is-focused');
                }
              }, delay);
              staggerIdx++;
              clearTimeout(staggerTimer);
              staggerTimer = setTimeout(() => { staggerIdx = 0; }, 400);
              observer.unobserve(entry.target);
            }
          });
        }, { rootMargin: '0px 0px -30px 0px', threshold: 0.08 });

        document.querySelectorAll('.reveal-target, .blur-reveal').forEach(el => {
          el.classList.remove('is-revealed', 'is-focused');
          observer.observe(el);
        });

        // Prose content auto-reveal
        document.querySelectorAll('.prose p, .prose h2, .prose h3, .prose pre, .prose blockquote, .prose ul, .prose ol').forEach(el => {
          el.classList.add('reveal-target');
          el.classList.remove('is-revealed');
          observer.observe(el);
        });
      }

      initReveal();
      document.addEventListener('astro:page-load', initReveal);
    </script>
    <script is:inline>
      function initPageClickWave() {
        window.__pageClickWaveLayer = document.getElementById('page-click-wave');
        if (window.__pageClickWaveReady) return;
        window.__pageClickWaveReady = true;

        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

        document.addEventListener('pointerdown', (event) => {
          if (reduceMotion.matches) return;
          const layer = window.__pageClickWaveLayer;
          if (!layer) return;
          layer.style.setProperty('--page-wave-x', `${event.clientX}px`);
          layer.style.setProperty('--page-wave-y', `${event.clientY}px`);
          layer.classList.remove('is-waving');
          void layer.offsetWidth;
          layer.classList.add('is-waving');
        }, { passive: true });

        document.addEventListener('animationend', (event) => {
          const layer = window.__pageClickWaveLayer;
          if (event.target === layer && event.animationName === 'waterDropRing') {
            layer.classList.remove('is-waving');
          }
        });
      }

      initPageClickWave();
      if (!window.__pageClickWavePageLoadReady) {
        window.__pageClickWavePageLoadReady = true;
        document.addEventListener('astro:page-load', initPageClickWave);
      }
    </script>
    <div id="page-click-wave" class="page-click-wave" aria-hidden="true"></div>

    <!-- 全局胶片颗粒 -->
    <svg class="global-film-grain" aria-hidden="true" preserveAspectRatio="none">
      <defs>
        <filter id="global-grain-noise"><feTurbulence type="fractalNoise" baseFrequency="0.7" numOctaves="3" stitchTiles="stitch"/><feColorMatrix type="saturate" values="0"/></filter>
      </defs>
      <rect width="100%" height="100%" filter="url(#global-grain-noise)" opacity="0.04"/>
    </svg>

    <!-- 全局光标光晕 -->
    <script is:inline>
    (function() {
      if (document.getElementById('global-cursor-glow')) return;
      const glow = document.createElement('div');
      glow.id = 'global-cursor-glow';
      glow.style.cssText = 'position:fixed;width:500px;height:500px;border-radius:50%;pointer-events:none;z-index:9991;transform:translate(-50%,-50%);opacity:0;transition:opacity 0.5s cubic-bezier(0.16,1,0.3,1);background:radial-gradient(circle,rgba(180,155,115,0.045) 0%,rgba(160,140,100,0.015) 35%,transparent 70%);will-change:left,top;';
      document.body.appendChild(glow);
      let pending = false;
      const onMove = (e) => {
        if (!pending) {
          pending = true;
          requestAnimationFrame(() => {
            glow.style.left = e.clientX + 'px';
            glow.style.top = e.clientY + 'px';
            glow.style.opacity = '1';
            pending = false;
          });
        }
      };
      const onLeave = () => { glow.style.opacity = '0'; };
      document.addEventListener('mousemove', onMove, { passive: true });
      document.addEventListener('mouseleave', onLeave);
      document.addEventListener('astro:before-swap', () => {
        document.removeEventListener('mousemove', onMove);
        document.removeEventListener('mouseleave', onLeave);
      }, { once: true });
    })();
    </script>

    <!-- 背景视差 — 滚动时微移背景 -->
    <script is:inline>
    (function() {
      let ticking = false;
      const bgLayer = document.querySelector('.global-bg-layer');
      if (!bgLayer) return;
      const onScroll = () => {
        if (!ticking) {
          requestAnimationFrame(() => {
            const y = window.scrollY;
            const translate = Math.min(y * 0.04, 60);
            bgLayer.style.transform = `translateY(${translate.toFixed(1)}px)`;
            ticking = false;
          });
          ticking = true;
        }
      };
      window.addEventListener('scroll', onScroll, { passive: true });
    })();
    </script>
  </body>
</html>
