---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="文本对比" description="在线文本差异对比工具">
  <div class="max-w-5xl mx-auto px-6 py-12">
    <div class="mb-8">
      <a href={`${import.meta.env.BASE_URL}tools/`} class="text-sm text-accent dark:text-dark-accent hover:underline mb-4 inline-block">&larr; 所有工具</a>
      <span class="inline-block px-3 py-1 text-xs font-sans tracking-widest text-accent dark:text-dark-accent border border-accent/30 dark:border-dark-accent/30 mb-4">TOOLS</span>
      <h1 class="font-display text-3xl font-bold text-text dark:text-dark-text">文本对比</h1>
      <p class="text-text-muted dark:text-dark-text-muted mt-2 font-serif">高亮两段文本的差异</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
      <div>
        <label class="block text-sm font-medium text-text dark:text-dark-text mb-2">原始文本</label>
        <textarea id="text-a" class="w-full h-56 bg-surface-alt dark:bg-dark-surface-alt border border-border/40 dark:border-dark-border/40 rounded-xl p-4 font-mono text-sm text-text dark:text-dark-text resize-y focus:outline-none focus:border-accent dark:focus:border-dark-accent focus:ring-2 focus:ring-accent/10 dark:focus:ring-dark-accent/10 transition-all" placeholder="输入第一段文本...">Hello World
这是一段测试文本
第三行内容
第四行</textarea>
      </div>
      <div>
        <label class="block text-sm font-medium text-text dark:text-dark-text mb-2">对比文本</label>
        <textarea id="text-b" class="w-full h-56 bg-surface-alt dark:bg-dark-surface-alt border border-border/40 dark:border-dark-border/40 rounded-xl p-4 font-mono text-sm text-text dark:text-dark-text resize-y focus:outline-none focus:border-accent dark:focus:border-dark-accent focus:ring-2 focus:ring-accent/10 dark:focus:ring-dark-accent/10 transition-all" placeholder="输入第二段文本...">Hello World
这是一段修改后的文本
第三行内容
新增第五行</textarea>
      </div>
    </div>

    <button id="btn-diff" class="px-4 py-2 text-sm font-medium bg-accent dark:bg-dark-accent text-white rounded-lg hover:bg-accent-light hover:shadow-md hover:shadow-accent/20 dark:hover:shadow-dark-accent/20 transition-all mb-4">对比</button>

    <div>
      <div class="flex items-center gap-4 mb-2">
        <label class="text-sm font-medium text-text dark:text-dark-text">差异结果</label>
        <div class="flex gap-3 text-xs">
          <span class="flex items-center gap-1"><span class="w-3 h-3 rounded bg-green-500/20 border border-green-500/40"></span> 新增</span>
          <span class="flex items-center gap-1"><span class="w-3 h-3 rounded bg-red-500/20 border border-red-500/40"></span> 删除</span>
          <span class="flex items-center gap-1"><span class="w-3 h-3 rounded bg-yellow-500/20 border border-yellow-500/40"></span> 修改</span>
        </div>
      </div>
      <div id="diff-result" class="w-full min-h-[200px] bg-surface-alt dark:bg-dark-surface-alt border border-border/40 dark:border-dark-border/40 rounded-xl p-4 font-mono text-sm whitespace-pre-wrap overflow-x-auto shadow-sm"></div>
    </div>
  </div>

  <script is:inline>
    document.getElementById('btn-diff').addEventListener('click', () => {
      const a = document.getElementById('text-a').value.split('\n');
      const b = document.getElementById('text-b').value.split('\n');
      const result = document.getElementById('diff-result');

      // Simple line-by-line diff
      const maxLen = Math.max(a.length, b.length);
      let html = '';

      for (let i = 0; i < maxLen; i++) {
        const lineA = a[i];
        const lineB = b[i];

        if (lineA === undefined) {
          html += `<div class="bg-green-500/10 border-l-2 border-green-500 px-2 py-0.5"><span class="text-green-600 dark:text-green-400">+ </span>${esc(lineB)}</div>`;
        } else if (lineB === undefined) {
          html += `<div class="bg-red-500/10 border-l-2 border-red-500 px-2 py-0.5"><span class="text-red-600 dark:text-red-400">- </span>${esc(lineA)}</div>`;
        } else if (lineA !== lineB) {
          html += `<div class="bg-red-500/10 border-l-2 border-red-500 px-2 py-0.5"><span class="text-red-600 dark:text-red-400">- </span>${esc(lineA)}</div>`;
          html += `<div class="bg-green-500/10 border-l-2 border-green-500 px-2 py-0.5"><span class="text-green-600 dark:text-green-400">+ </span>${esc(lineB)}</div>`;
        } else {
          html += `<div class="px-2 py-0.5 text-text-muted dark:text-dark-text-muted">  ${esc(lineA)}</div>`;
        }
      }

      result.innerHTML = html || '<span class="text-text-muted dark:text-dark-text-muted">两段文本完全相同</span>';
    });

    function esc(s) { return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }

    // Auto-run on load
    document.getElementById('btn-diff').click();
  </script>
</BaseLayout>
