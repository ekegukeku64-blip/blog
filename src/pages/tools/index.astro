---
import BaseLayout from '../../layouts/BaseLayout.astro';

const categories = [
  {
    name: '编码转换',
    desc: '数据格式与编码互转',
    accent: '01',
    tools: [
      { name: 'JSON 格式化', desc: '格式化、校验、压缩 JSON', icon: '{ }', slug: 'json' },
      { name: 'Base64 编解码', desc: '文本与 Base64 互转', icon: 'B64', slug: 'base64' },
      { name: '颜色转换器', desc: 'HEX / RGB / HSL 互转', icon: '#', slug: 'color' },
      { name: 'URL 编解码', desc: 'URL 编码与解码', icon: '%', slug: 'url' },
      { name: '时间戳转换', desc: 'Unix 时间戳与日期互转', icon: '⏱', slug: 'timestamp' },
    ],
  },
  {
    name: '文本处理',
    desc: '文本分析、预览与对比',
    accent: '02',
    tools: [
      { name: 'Markdown 预览', desc: '实时 Markdown 渲染', icon: 'M↓', slug: 'markdown' },
      { name: '文本对比', desc: '高亮两段文本的差异', icon: '≠', slug: 'diff' },
      { name: '字数统计', desc: '字符、单词、行数统计', icon: '字', slug: 'counter' },
      { name: '正则测试', desc: '在线测试正则表达式', icon: '.*', slug: 'regex' },
      { name: '密码生成器', desc: '生成安全随机密码', icon: '🔒', slug: 'password' },
    ],
  },
  {
    name: '图片处理',
    desc: '图像编辑与优化',
    accent: '03',
    tools: [
      { name: '智能抠图', desc: 'AI 一键抠图，手动微调', icon: '✂', slug: 'remove-bg' },
      { name: '图片压缩', desc: '压缩图片体积，JPG/PNG/WebP', icon: '📦', slug: 'compress' },
      { name: 'CSS 渐变', desc: '可视化生成 CSS 渐变代码', icon: '🌈', slug: 'gradient' },
    ],
  },
  {
    name: '开发辅助',
    desc: '开发者常用小工具',
    accent: '04',
    tools: [
      { name: '二维码生成', desc: '文字/链接转二维码', icon: '▦', slug: 'qrcode' },
      { name: 'GitHub 查看', desc: '不跳转直接看仓库 README', icon: 'GH', slug: 'github' },
    ],
  },
];
const totalTools = categories.reduce((sum, cat) => sum + cat.tools.length, 0);
---

<BaseLayout title="在线工具" description="浏览器端运行的实用工具集合，数据不上传服务器">
  <div class="max-w-6xl mx-auto px-6 py-14 md:py-20">
    <div class="tool-lab-hero ink-reveal">
      <div>
        <span class="inline-block px-3 py-1 text-[11px] font-sans tracking-[0.28em] text-accent dark:text-dark-accent border border-accent/25 dark:border-dark-accent/25 mb-5 uppercase">Toolbox</span>
        <h1 class="font-display text-4xl md:text-6xl font-bold text-text dark:text-dark-text mb-4">个人实验室</h1>
        <p class="text-text-muted dark:text-dark-text-muted font-serif text-sm md:text-base max-w-xl leading-relaxed">
          一些真正能顺手用的小工具：格式转换、文本处理、图片优化和开发辅助。全部在浏览器本地运行，不上传任何数据到服务器。
        </p>
      </div>
      <div class="tool-lab-panel" aria-label="工具箱统计">
        <span>{totalTools}</span>
        <p>个本地工具</p>
      </div>
    </div>

    <!-- Categories -->
    {categories.map((cat, ci) => (
      <section class="tool-category ink-reveal" style={`animation-delay: ${(ci + 1) * 0.1}s`}>
        <div class="tool-category-head">
          <span>{cat.accent}</span>
          <div>
            <h2>{cat.name}</h2>
            <p>{cat.desc}</p>
          </div>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {cat.tools.map((tool) => (
            <a
              href={`${import.meta.env.BASE_URL}tools/${tool.slug}/`}
              class="tool-card group"
            >
              <div class="tool-icon">{tool.icon}</div>
              <div class="min-w-0">
                <h3>{tool.name}</h3>
                <p>{tool.desc}</p>
              </div>
            </a>
          ))}
        </div>
      </section>
    ))}

    <!-- Bottom note -->
    <div class="mt-16 pt-8 border-t border-border/20 dark:border-dark-border/20 ink-reveal" style="animation-delay:0.6s">
      <p class="text-xs text-text-muted dark:text-dark-text-muted font-serif text-center leading-relaxed">
        所有工具代码开源在 <a href="https://github.com/ekegukeku64-blip/blog" class="text-accent dark:text-dark-accent hover:underline">GitHub</a>，<br class="sm:hidden" />欢迎提建议或贡献新工具。
      </p>
    </div>
    <style>
      .tool-lab-hero {
        position: relative;
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        gap: 2rem;
        align-items: end;
        margin-bottom: 4rem;
        padding: 2rem;
        border: 1px solid rgba(255, 255, 255, 0.06);
        border-radius: 28px;
        background: radial-gradient(circle at 12% 0%, rgba(122, 149, 175, 0.16), transparent 34%), rgba(7, 12, 18, 0.46);
        box-shadow: inset 0 1px rgba(255, 255, 255, 0.04), 0 24px 70px rgba(0, 0, 0, 0.28);
        overflow: hidden;
      }

      .tool-lab-hero::after {
        content: "";
        position: absolute;
        right: -8rem;
        bottom: -9rem;
        width: 22rem;
        aspect-ratio: 1;
        border-radius: 999px;
        background: radial-gradient(circle, rgba(122, 149, 175, 0.14), transparent 68%);
        pointer-events: none;
      }

      .tool-lab-panel {
        position: relative;
        z-index: 1;
        min-width: 9rem;
        padding: 1.25rem;
        border-radius: 22px;
        border: 1px solid rgba(255, 255, 255, 0.08);
        background: rgba(255, 255, 255, 0.035);
        backdrop-filter: blur(20px);
        text-align: right;
      }

      .tool-lab-panel span {
        display: block;
        font-family: var(--font-display);
        font-size: 3rem;
        line-height: 1;
        color: var(--color-text);
      }

      .tool-lab-panel p {
        margin-top: 0.5rem;
        font-size: 0.75rem;
        color: var(--color-text-muted);
      }

      .tool-category {
        margin-bottom: 3.5rem;
      }

      .tool-category-head {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-bottom: 1.25rem;
      }

      .tool-category-head > span {
        display: grid;
        place-items: center;
        width: 2.75rem;
        height: 2.75rem;
        border-radius: 1rem;
        border: 1px solid rgba(122, 149, 175, 0.18);
        color: var(--color-accent);
        font-family: var(--font-mono);
        font-size: 0.75rem;
        background: rgba(122, 149, 175, 0.06);
      }

      .tool-category-head h2 {
        font-family: var(--font-display);
        font-size: 1.125rem;
        font-weight: 700;
        color: var(--color-text);
      }

      .tool-category-head p {
        margin-top: 0.15rem;
        font-family: var(--font-serif);
        font-size: 0.75rem;
        color: var(--color-text-muted);
      }

      .tool-card {
        position: relative;
        display: flex;
        min-height: 7rem;
        gap: 1rem;
        align-items: flex-start;
        padding: 1.25rem;
        border-radius: 1.1rem;
        border: 1px solid rgba(255, 255, 255, 0.055);
        background: linear-gradient(145deg, rgba(255, 255, 255, 0.045), rgba(255, 255, 255, 0.018));
        box-shadow: inset 0 1px rgba(255, 255, 255, 0.035);
        transition: transform 0.45s var(--interactive-ease), border-color 0.45s var(--interactive-ease), background 0.45s var(--interactive-ease);
        overflow: hidden;
      }

      .tool-card::after {
        content: "";
        position: absolute;
        inset: auto 1rem 0;
        height: 1px;
        background: linear-gradient(90deg, transparent, rgba(122, 149, 175, 0.5), transparent);
        opacity: 0;
        transition: opacity 0.45s var(--interactive-ease);
      }

      .tool-card:hover {
        transform: translateY(-4px);
        border-color: rgba(122, 149, 175, 0.24);
        background: linear-gradient(145deg, rgba(122, 149, 175, 0.09), rgba(255, 255, 255, 0.025));
      }

      .tool-card:hover::after {
        opacity: 1;
      }

      .tool-icon {
        display: grid;
        place-items: center;
        flex: 0 0 auto;
        width: 2.75rem;
        height: 2.75rem;
        border-radius: 0.9rem;
        border: 1px solid rgba(122, 149, 175, 0.14);
        background: rgba(7, 12, 18, 0.52);
        color: var(--color-accent);
        font-family: var(--font-mono);
        font-weight: 700;
        font-size: 0.86rem;
        transition: transform 0.45s var(--interactive-ease);
      }

      .tool-card:hover .tool-icon {
        transform: scale(1.08) rotate(-2deg);
      }

      .tool-card h3 {
        margin-bottom: 0.3rem;
        color: var(--color-text);
        font-size: 0.92rem;
        font-weight: 700;
        transition: color 0.3s var(--interactive-ease);
      }

      .tool-card:hover h3 {
        color: var(--color-accent);
      }

      .tool-card p {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        color: var(--color-text-muted);
        font-family: var(--font-serif);
        font-size: 0.78rem;
        line-height: 1.7;
      }

      @media (max-width: 768px) {
        .tool-lab-hero {
          grid-template-columns: 1fr;
          padding: 1.4rem;
        }

        .tool-lab-panel {
          min-width: 0;
          text-align: left;
        }
      }
    </style>
  </div>
</BaseLayout>
