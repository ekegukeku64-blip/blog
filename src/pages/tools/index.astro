---
import BaseLayout from '../../layouts/BaseLayout.astro';

const categories = [
  {
    name: '编码转换',
    desc: '数据格式与编码互转',
    tools: [
      { name: 'JSON 格式化', desc: '格式化、校验、压缩 JSON', icon: '{ }', slug: 'json' },
      { name: 'Base64 编解码', desc: '文本与 Base64 互转', icon: 'B64', slug: 'base64' },
      { name: '颜色转换器', desc: 'HEX / RGB / HSL 互转', icon: '#', slug: 'color' },
      { name: 'URL 编解码', desc: 'URL 编码与解码', icon: '%', slug: 'url' },
      { name: '时间戳转换', desc: 'Unix 时间戳与日期互转', icon: '⏱', slug: 'timestamp' },
    ],
  },
  {
    name: '文本处理',
    desc: '文本分析、预览与对比',
    tools: [
      { name: 'Markdown 预览', desc: '实时 Markdown 渲染', icon: 'M↓', slug: 'markdown' },
      { name: '文本对比', desc: '高亮两段文本的差异', icon: '≠', slug: 'diff' },
      { name: '字数统计', desc: '字符、单词、行数统计', icon: '字', slug: 'counter' },
      { name: '正则测试', desc: '在线测试正则表达式', icon: '.*', slug: 'regex' },
      { name: '密码生成器', desc: '生成安全随机密码', icon: '🔒', slug: 'password' },
    ],
  },
  {
    name: '图片处理',
    desc: '图像编辑与优化',
    tools: [
      { name: '智能抠图', desc: 'AI 一键抠图，手动微调', icon: '✂', slug: 'remove-bg' },
      { name: '图片压缩', desc: '压缩图片体积，JPG/PNG/WebP', icon: '📦', slug: 'compress' },
      { name: 'CSS 渐变', desc: '可视化生成 CSS 渐变代码', icon: '🌈', slug: 'gradient' },
    ],
  },
  {
    name: '开发辅助',
    desc: '开发者常用小工具',
    tools: [
      { name: '二维码生成', desc: '文字/链接转二维码', icon: '▦', slug: 'qrcode' },
      { name: 'GitHub 查看', desc: '不跳转直接看仓库 README', icon: 'GH', slug: 'github' },
    ],
  },
];
---

<BaseLayout title="在线工具" description="浏览器端运行的实用工具集合，数据不上传服务器">
  <div class="max-w-5xl mx-auto px-6 py-14 md:py-20">
    <!-- Header -->
    <div class="mb-14 ink-reveal">
      <span class="inline-block px-3 py-1 text-[11px] font-sans tracking-[0.28em] text-accent dark:text-dark-accent border border-accent/25 dark:border-dark-accent/25 mb-5 uppercase">Toolbox</span>
      <h1 class="font-display text-4xl md:text-5xl font-bold text-text dark:text-dark-text mb-3">在线工具</h1>
      <p class="text-text-muted dark:text-dark-text-muted font-serif text-sm md:text-base max-w-lg leading-relaxed">
        全部在浏览器本地运行，不上传任何数据到服务器。
      </p>
    </div>

    <!-- Categories -->
    {categories.map((cat, ci) => (
      <section class="mb-12 ink-reveal" style={`animation-delay: ${(ci + 1) * 0.1}s`}>
        <div class="flex items-baseline gap-3 mb-5">
          <h2 class="font-display text-lg font-bold text-text dark:text-dark-text">{cat.name}</h2>
          <span class="text-xs text-text-muted dark:text-dark-text-muted font-serif">{cat.desc}</span>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {cat.tools.map((tool) => (
            <a
              href={`${import.meta.env.BASE_URL}tools/${tool.slug}/`}
              class="group relative block p-5 rounded-xl border border-border/30 dark:border-dark-border/30 hover:border-accent/30 dark:hover:border-dark-accent/30 hover:shadow-lg hover:shadow-accent/3 dark:hover:shadow-dark-accent/3 transition-all duration-300 bg-surface/40 dark:bg-dark-surface/40 hover:bg-surface dark:hover:bg-dark-surface"
            >
              <div class="flex items-start gap-3.5">
                <div class="w-10 h-10 rounded-lg bg-surface-alt dark:bg-dark-surface-alt flex items-center justify-center text-sm font-mono font-bold text-accent dark:text-dark-accent shrink-0 group-hover:scale-110 transition-transform duration-300 border border-accent/8 dark:border-dark-accent/8">
                  {tool.icon}
                </div>
                <div class="min-w-0">
                  <h3 class="font-bold text-sm text-text dark:text-dark-text mb-1 group-hover:text-accent dark:group-hover:text-dark-accent transition-colors">
                    {tool.name}
                  </h3>
                  <p class="text-xs text-text-muted dark:text-dark-text-muted font-serif leading-relaxed line-clamp-1">
                    {tool.desc}
                  </p>
                </div>
              </div>
            </a>
          ))}
        </div>
      </section>
    ))}

    <!-- Bottom note -->
    <div class="mt-16 pt-8 border-t border-border/20 dark:border-dark-border/20 ink-reveal" style="animation-delay:0.6s">
      <p class="text-xs text-text-muted dark:text-dark-text-muted font-serif text-center leading-relaxed">
        所有工具代码开源在 <a href="https://github.com/ekegukeku64-blip/blog" class="text-accent dark:text-dark-accent hover:underline">GitHub</a>，<br class="sm:hidden" />欢迎提建议或贡献新工具。
      </p>
    </div>
  </div>
</BaseLayout>
