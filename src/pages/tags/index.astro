---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('posts', ({ data }) => !data.draft);

// Count posts per tag
const tagCounts = new Map<string, number>();
allPosts.forEach(post => {
  post.data.tags.forEach(tag => {
    tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
  });
});

// Sort by count descending
const sortedTags = [...tagCounts.entries()].sort((a, b) => b[1] - a[1]);
---

<BaseLayout title="标签" description="按标签浏览文章">
  <div class="max-w-5xl mx-auto px-6 py-16">
    <div class="mb-10">
      <span class="inline-block px-3 py-1 text-xs font-sans tracking-widest text-accent dark:text-dark-accent border border-accent/30 dark:border-dark-accent/30 mb-4">TAGS</span>
      <h1 class="font-display text-4xl font-bold text-text dark:text-dark-text mb-3">标签</h1>
      <p class="text-text-muted dark:text-dark-text-muted font-serif">共 {sortedTags.length} 个标签</p>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-4">
      {sortedTags.map(([tag, count]) => (
        <a
          href={`${import.meta.env.BASE_URL}tags/${tag}/`}
          class="group flex items-center justify-between px-5 py-4 border border-border/60 dark:border-dark-border/60 rounded-xl shadow-sm hover:border-accent dark:hover:border-dark-accent hover:bg-surface-alt/50 dark:hover:bg-dark-surface-alt/50 hover:shadow-lg hover:shadow-accent/5 dark:hover:shadow-dark-accent/5 transition-all duration-300 bg-gradient-to-br from-surface/50 to-surface-alt/30 dark:from-dark-surface/50 dark:to-dark-surface-alt/30"
        >
          <span class="font-serif font-medium text-text dark:text-dark-text group-hover:text-accent dark:group-hover:text-dark-accent transition-colors">
            {tag}
          </span>
          <span class="text-sm text-text-muted dark:text-dark-text-muted bg-surface-alt/50 dark:bg-dark-surface-alt/50 px-2 py-0.5 rounded-full">
            {count}
          </span>
        </a>
      ))}
    </div>

    {sortedTags.length === 0 && (
      <div class="text-center py-24 text-text-muted dark:text-dark-text-muted">
        <p class="text-lg font-serif">暂无标签</p>
      </div>
    )}
  </div>
</BaseLayout>
