---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('posts', ({ data }) => !data.draft);

// Count posts per tag
const tagCounts = new Map<string, number>();
allPosts.forEach(post => {
  post.data.tags.forEach(tag => {
    tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
  });
});

// Sort by count descending
const sortedTags = [...tagCounts.entries()].sort((a, b) => b[1] - a[1]);
---

<BaseLayout title="标签" description="按标签浏览文章">
  <div class="max-w-5xl mx-auto px-6 py-16">
    <div class="mb-10">
      <span class="inline-block px-4 py-1 text-[10px] font-sans tracking-[0.25em] uppercase text-accent border border-accent/25 rounded-full mb-5">标签</span>
      <h1 class="font-display text-4xl md:text-5xl font-bold text-text mb-3">标签</h1>
      <p class="text-text-muted font-serif text-lg">{sortedTags.length} 个标签 · {allPosts.length} 篇文章</p>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3">
      {sortedTags.map(([tag, count]) => (
        <a
          href={`${import.meta.env.BASE_URL}tag/${tag}/`}
          class="reveal-target group flex items-center justify-between px-5 py-4 border border-white/[0.05] rounded-xl hover:border-accent/25 hover:bg-[#0a0f1a]/60 transition-all duration-400 bg-[#070a13]/40"
        >
          <span class="font-serif font-medium text-text group-hover:text-accent transition-colors duration-300">
            {tag}
          </span>
          <span class="text-xs text-text-muted bg-white/[0.03] px-2 py-0.5 rounded-full border border-white/[0.04]">
            {count}
          </span>
        </a>
      ))}
    </div>

    {sortedTags.length === 0 && (
      <div class="text-center py-24 text-text-muted dark:text-dark-text-muted">
        <p class="text-lg font-serif">暂无标签</p>
      </div>
    )}
  </div>
</BaseLayout>
