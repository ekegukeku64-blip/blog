---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import Sidebar from '../../components/Sidebar.astro';
import { getCollection } from 'astro:content';
import { calcReadingTime } from '../../utils/readingTime';

const allPosts = await getCollection('posts', ({ data }) => !data.draft);
const sortedPosts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Sidebar data
const categories = [...new Set(allPosts.map(p => p.data.category))].map(name => ({
  name,
  count: allPosts.filter(p => p.data.category === name).length,
}));
const allTags = [...new Set(allPosts.flatMap(p => p.data.tags))];
const sidebarPosts = sortedPosts.slice(0, 5).map(p => ({
  title: p.data.title,
  slug: p.id,
  pubDate: p.data.pubDate,
}));

// 按分类分组
const groupedByCategory = sortedPosts.reduce((acc, post) => {
  const cat = post.data.category;
  if (!acc[cat]) acc[cat] = [];
  acc[cat].push(post);
  return acc;
}, {} as Record<string, typeof sortedPosts>);

// 分类展示顺序
const categoryOrder = ['成长记录', '技术'];
const sortedCategories = categoryOrder.filter(c => groupedByCategory[c]);
const allCategories = [...sortedCategories, ...Object.keys(groupedByCategory).filter(c => !categoryOrder.includes(c))];

// 分类图标
const categoryIcons: Record<string, string> = {
  '成长记录': `<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" /></svg>`,
  '技术': `<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" /></svg>`,
};
---

<BaseLayout title="文章" description="所有文章列表">
  <div class="max-w-5xl mx-auto px-6 py-16">
    <div class="mb-8 ink-reveal">
      <span class="inline-block px-3 py-1 text-xs font-sans tracking-widest text-accent dark:text-dark-accent border border-accent/30 dark:border-dark-accent/30 mb-4">ARTICLES</span>
      <h1 class="font-display text-4xl font-bold text-text dark:text-dark-text mb-3">所有文章</h1>
      <p class="text-text-muted dark:text-dark-text-muted font-serif">共 {sortedPosts.length} 篇文章</p>
    </div>

    <!-- Search -->
    <div class="mb-8 ink-reveal ink-reveal-delay-1">
      <div class="relative group/search">
        <div class="absolute -inset-1 bg-gradient-to-r from-accent/0 via-accent/10 to-accent/0 dark:from-dark-accent/0 dark:via-dark-accent/10 dark:to-dark-accent/0 rounded-2xl opacity-0 group-focus-within/search:opacity-100 transition-opacity duration-500 blur-sm"></div>
        <div class="relative">
          <svg class="absolute left-4 top-1/2 -translate-y-1/2 w-4 h-4 text-text-muted dark:text-dark-text-muted group-focus-within/search:text-accent dark:group-focus-within/search:text-dark-accent transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>
          <input type="text" id="search-input" class="w-full bg-surface-alt dark:bg-dark-surface-alt border border-border/40 dark:border-dark-border/40 rounded-xl pl-11 pr-4 py-3 text-sm text-text dark:text-dark-text focus:outline-none focus:border-accent/60 dark:focus:border-dark-accent/60 focus:ring-2 focus:ring-accent/10 dark:focus:ring-dark-accent/10 transition-all" placeholder="搜索文章标题、描述..." />
        </div>
      </div>
      <p id="search-count" class="mt-3 text-xs text-accent dark:text-dark-accent font-serif hidden"></p>
    </div>

    <!-- Category filter -->
    <div class="flex flex-wrap gap-2 mb-10 ink-reveal ink-reveal-delay-2">
      <a href={`${import.meta.env.BASE_URL}blog`} class="seal seal-solid">全部</a>
      {allCategories.map(cat => (
        <a href={`${import.meta.env.BASE_URL}category/${cat}/`} class="seal hover:bg-accent hover:text-white dark:hover:bg-dark-accent dark:hover:text-dark-surface transition-all hover:shadow-md hover:shadow-accent/10 dark:hover:shadow-dark-accent/10">
          {cat}
        </a>
      ))}
    </div>

    <!-- Posts + Sidebar -->
    <div class="flex flex-col md:flex-row gap-10">
      <div class="flex-1 min-w-0">
        <div id="posts-grid">
          {allCategories.map((cat, catIdx) => (
            <div class="category-section mb-14" data-category={cat}>
              <div class="flex items-center gap-3 mb-6 ink-reveal" data-category-header={cat}>
                <span class="text-accent dark:text-dark-accent" set:html={categoryIcons[cat] || categoryIcons['技术']} />
                <h2 class="font-display text-xl font-bold text-text dark:text-dark-text">{cat}</h2>
                <span class="text-xs text-text-muted dark:text-dark-text-muted font-sans bg-surface-alt dark:bg-dark-surface-alt px-2.5 py-0.5 rounded-full">
                  {groupedByCategory[cat].length} 篇
                </span>
              </div>
              <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                {groupedByCategory[cat].map((post, i) => (
                  <div class:list={['ink-reveal', `ink-reveal-delay-${(i % 4) + 1}`]} data-title={post.data.title.toLowerCase()} data-desc={post.data.description.toLowerCase()} data-tags={post.data.tags.join(',').toLowerCase()}>
                    <PostCard
                      title={post.data.title}
                      description={post.data.description}
                      pubDate={post.data.pubDate}
                      heroImage={post.data.heroImage}
                      tags={post.data.tags}
                      category={post.data.category}
                      slug={post.id}
                      readingTime={calcReadingTime(post.body || '')}
                    />
                  </div>
                ))}
              </div>
            </div>
          ))}
        </div>

        {sortedPosts.length === 0 && (
          <div class="text-center py-24 text-text-muted dark:text-dark-text-muted">
            <p class="text-lg font-serif">暂无文章</p>
          </div>
        )}
      </div>

      <!-- 侧边栏 -->
      <div class="w-full md:w-72 shrink-0 ink-reveal ink-reveal-delay-2">
        <Sidebar categories={categories} recentPosts={sidebarPosts} />
      </div>
    </div>
  </div>
  <script is:inline>
    document.addEventListener('astro:page-load', () => {
      const searchInput = document.getElementById('search-input');
      const postsGrid = document.getElementById('posts-grid');
      const searchCount = document.getElementById('search-count');
      if (!searchInput || !postsGrid) return;

      searchInput.addEventListener('input', () => {
        const query = searchInput.value.trim().toLowerCase();
        const sections = postsGrid.querySelectorAll('.category-section');
        let totalVisible = 0;

        sections.forEach(section => {
          const cards = section.querySelectorAll('[data-title]');
          let sectionVisible = 0;

          cards.forEach(card => {
            if (!query) {
              card.style.display = '';
              sectionVisible++;
              return;
            }
            const title = card.dataset.title || '';
            const desc = card.dataset.desc || '';
            const tags = card.dataset.tags || '';
            const match = title.includes(query) || desc.includes(query) || tags.includes(query);
            card.style.display = match ? '' : 'none';
            if (match) sectionVisible++;
          });

          // 隐藏没有匹配文章的分类
          const header = section.querySelector('[data-category-header]');
          if (query && sectionVisible === 0) {
            section.style.display = 'none';
          } else {
            section.style.display = '';
          }

          // 更新分类计数
          if (header && query) {
            const countEl = header.querySelector('span:last-child');
            if (countEl) countEl.textContent = `${sectionVisible} 篇`;
          }

          totalVisible += sectionVisible;
        });

        if (query) {
          searchCount.textContent = `找到 ${totalVisible} 篇文章`;
          searchCount.classList.remove('hidden');
        } else {
          searchCount.classList.add('hidden');
        }
      });
    });
  </script>
</BaseLayout>
