---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeHero from '../components/home/HomeHero.astro';
import HomeFeaturedPost from '../components/home/HomeFeaturedPost.astro';
import HomeRecentPosts from '../components/home/HomeRecentPosts.astro';
import HomeTaxonomy from '../components/home/HomeTaxonomy.astro';
import HomeTechDaily from '../components/home/HomeTechDaily.astro';
import HomeFootnote from '../components/home/HomeFootnote.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('posts', ({ data }) => !data.draft);
const sortedPosts = [...allPosts].sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const featuredPost = sortedPosts.find(p => p.data.featured);
const recentPosts = sortedPosts.filter(p => p !== featuredPost).slice(0, 8);

const categories = [...new Set(allPosts.map(p => p.data.category))].map(name => ({
  name,
  count: allPosts.filter(p => p.data.category === name).length,
}));
const allTags = [...new Set(allPosts.flatMap(p => p.data.tags))];

const now = new Date();
const thisMonth = sortedPosts.filter(p => {
  const d = p.data.pubDate;
  return d.getFullYear() === now.getFullYear() && d.getMonth() === now.getMonth();
}).length;
const totalWords = allPosts.reduce((sum, p) => sum + (p.body?.length || 0), 0);
const wordCount = totalWords > 10000 ? `${(totalWords / 10000).toFixed(1)}万` : `${totalWords}`;
const focusCards = [
  { label: 'AI 工具', text: '把试过的工具、提示词和踩坑写成人能看懂的记录。', href: `${import.meta.env.BASE_URL}blog/?category=${encodeURIComponent('AI工具')}` },
  { label: '实用工具箱', text: '浏览器本地运行的小工具，解决格式转换、文本处理和图片问题。', href: `${import.meta.env.BASE_URL}tools/` },
  { label: '成长日志', text: '记录非传统路线上的选择、试错和阶段性复盘。', href: `${import.meta.env.BASE_URL}growth/` },
];

let streak = 0;
const today = new Date(now.getFullYear(), now.getMonth(), now.getDate());
for (let i = 0; i < 365; i++) {
  const day = new Date(today);
  day.setDate(day.getDate() - i);
  const hasPost = sortedPosts.some(p => {
    const d = new Date(p.data.pubDate.getFullYear(), p.data.pubDate.getMonth(), p.data.pubDate.getDate());
    return d.getTime() === day.getTime();
  });
  if (hasPost || i > 0) {
    if (hasPost) streak++;
    else if (i > 0) break;
  }
}
if (streak === 0) {
  for (let i = 1; i <= 365; i++) {
    const day = new Date(today);
    day.setDate(day.getDate() - i);
    const hasPost = sortedPosts.some(p => {
      const d = new Date(p.data.pubDate.getFullYear(), p.data.pubDate.getMonth(), p.data.pubDate.getDate());
      return d.getTime() === day.getTime();
    });
    if (hasPost) streak++;
    else break;
  }
}
---

<BaseLayout title="首页" description="墨迹 — AI 工具、真实试错和普通人能用的经验">
  <main class="home-page">
    <div class="home-page-orbit home-page-orbit--cold"></div>
    <div class="home-page-orbit home-page-orbit--warm"></div>
    <div class="home-page-spine"></div>
    <div class="home-section-stack">
      <HomeHero
        focusCards={focusCards}
        postCount={allPosts.length}
        thisMonth={thisMonth}
        wordCount={wordCount}
        streak={streak}
      />
      {featuredPost && <HomeFeaturedPost post={featuredPost} />}
      <HomeRecentPosts posts={recentPosts} />
      <HomeTaxonomy categories={categories} tags={allTags} />
      <HomeTechDaily />
      <HomeFootnote />
    </div>
  </main>
</BaseLayout>

<style>
.home-page {
  position: relative;
  isolation: isolate;
  overflow: hidden;
  padding-bottom: 2rem;
}

.home-page::before,
.home-page::after {
  content: "";
  position: absolute;
  pointer-events: none;
  z-index: -1;
}

.home-page::before {
  inset: 4rem 0 auto;
  height: 42rem;
  background:
    radial-gradient(ellipse 42% 55% at 18% 10%, rgba(122, 149, 175, 0.16), transparent 68%),
    radial-gradient(ellipse 28% 42% at 82% 18%, rgba(200, 182, 142, 0.08), transparent 72%);
  opacity: 0.9;
}

.home-page::after {
  right: -12rem;
  top: 20rem;
  width: 34rem;
  height: 62rem;
  border: 1px solid rgba(122, 149, 175, 0.08);
  border-radius: 999px;
  transform: rotate(18deg);
  box-shadow: inset 0 0 80px rgba(122, 149, 175, 0.04);
}

.home-page-orbit {
  position: absolute;
  pointer-events: none;
  z-index: -1;
  border-radius: 999px;
  filter: blur(1px);
}

.home-page-orbit--cold {
  left: -10rem;
  top: 38rem;
  width: 26rem;
  height: 26rem;
  border: 1px solid rgba(122, 149, 175, 0.10);
  background: radial-gradient(circle, rgba(122, 149, 175, 0.05), transparent 62%);
}

.home-page-orbit--warm {
  right: 8vw;
  top: 74rem;
  width: 16rem;
  height: 16rem;
  border: 1px solid rgba(200, 182, 142, 0.08);
  background: radial-gradient(circle, rgba(200, 182, 142, 0.035), transparent 64%);
}

.home-page-spine {
  position: absolute;
  left: max(1.25rem, calc((100vw - 1200px) / 2 - 2.25rem));
  top: 8rem;
  bottom: 5rem;
  width: 1px;
  pointer-events: none;
  z-index: 0;
  background: linear-gradient(180deg, transparent, rgba(122, 149, 175, 0.22), rgba(200, 182, 142, 0.16), transparent);
}

.home-section-stack {
  position: relative;
  z-index: 1;
}

@media (max-width: 900px) {
  .home-page-spine {
    left: 0.75rem;
    opacity: 0.45;
  }

  .home-page::after,
  .home-page-orbit--warm {
    display: none;
  }
}
</style>
