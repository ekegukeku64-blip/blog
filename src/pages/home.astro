---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { getCollection } from 'astro:content';
import { calcReadingTime } from '../utils/readingTime';

const allPosts = await getCollection('posts', ({ data }) => !data.draft);
const sortedPosts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const featuredPost = sortedPosts.find(p => p.data.featured);
const recentPosts = sortedPosts.filter(p => p !== featuredPost).slice(0, 8);

const categories = [...new Set(allPosts.map(p => p.data.category))].map(name => ({
  name,
  count: allPosts.filter(p => p.data.category === name).length,
}));
const allTags = [...new Set(allPosts.flatMap(p => p.data.tags))];

const now = new Date();
const thisMonth = sortedPosts.filter(p => {
  const d = p.data.pubDate;
  return d.getFullYear() === now.getFullYear() && d.getMonth() === now.getMonth();
}).length;
const totalWords = allPosts.reduce((sum, p) => sum + (p.body?.length || 0), 0);
const wordCount = totalWords > 10000 ? `${(totalWords / 10000).toFixed(1)}万` : `${totalWords}`;
const focusCards = [
  { label: 'AI 工具', text: '把试过的工具、提示词和踩坑写成人能看懂的记录。', href: `${import.meta.env.BASE_URL}blog/?category=${encodeURIComponent('AI工具')}` },
  { label: '实用工具箱', text: '浏览器本地运行的小工具，解决格式转换、文本处理和图片问题。', href: `${import.meta.env.BASE_URL}tools/` },
  { label: '成长日志', text: '记录非传统路线上的选择、试错和阶段性复盘。', href: `${import.meta.env.BASE_URL}growth/` },
];

let streak = 0;
const today = new Date(now.getFullYear(), now.getMonth(), now.getDate());
for (let i = 0; i < 365; i++) {
  const day = new Date(today);
  day.setDate(day.getDate() - i);
  const hasPost = sortedPosts.some(p => {
    const d = new Date(p.data.pubDate.getFullYear(), p.data.pubDate.getMonth(), p.data.pubDate.getDate());
    return d.getTime() === day.getTime();
  });
  if (hasPost || i > 0) {
    if (hasPost) streak++;
    else if (i > 0) break;
  }
}
if (streak === 0) {
  for (let i = 1; i <= 365; i++) {
    const day = new Date(today);
    day.setDate(day.getDate() - i);
    const hasPost = sortedPosts.some(p => {
      const d = new Date(p.data.pubDate.getFullYear(), p.data.pubDate.getMonth(), p.data.pubDate.getDate());
      return d.getTime() === day.getTime();
    });
    if (hasPost) streak++;
    else break;
  }
}
---

<BaseLayout title="首页" description="墨迹 — AI 工具、真实试错和普通人能用的经验">
  <!-- ════ EDITORIAL HERO ════ -->
  <section class="home-hero">
    <div class="home-hero-inner">
      <div class="home-hero-main">
        <p class="home-hero-kicker">AI tools / honest notes / useful experiments</p>
        <h1 class="home-hero-title">
          <span class="home-hero-title-line">记录，</span>
          <span class="home-hero-title-line home-hero-title-line--accent">然后发生。</span>
        </h1>
        <p class="home-hero-desc">
          一个把 AI 工具踩坑、实用小项目和真实成长记录放在一起的空间。
          不装专家，只展示执行力怎么把想法变成东西。
        </p>
        <div class="home-hero-actions">
          <a href={`${import.meta.env.BASE_URL}blog/`} class="home-hero-btn home-hero-btn--primary">
            开始阅读
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
          <a href={`${import.meta.env.BASE_URL}tools/`} class="home-hero-btn home-hero-btn--secondary">
            看工具箱
          </a>
        </div>

        <!-- Focus cards inline -->
        <div class="home-focus-row">
          {focusCards.map((card) => (
            <a href={card.href} class="home-focus-chip">
              <span>{card.label}</span>
              <span>{card.text}</span>
            </a>
          ))}
        </div>
      </div>

      <div class="home-hero-stats">
        <div class="home-stats-card">
          <div class="home-stats-label">文章</div>
          <div class="home-stats-number">{allPosts.length}</div>
          <div class="home-stats-bar" style="width: 100%"></div>

          <div class="home-stats-label" style="margin-top: 1.25rem">本月</div>
          <div class="home-stats-number">{thisMonth}</div>
          <div class="home-stats-bar" style="width: {Math.min(thisMonth / 5 * 100, 100)}%"></div>

          <div class="home-stats-label" style="margin-top: 1.25rem">字数</div>
          <div class="home-stats-number">{wordCount}</div>
          <div class="home-stats-bar" style="width: 80%"></div>

          {streak > 0 && (
            <p class="home-stats-streak">连续更新 {streak} 天</p>
          )}
        </div>
      </div>
    </div>
  </section>

  <!-- ════ FEATURED SPREAD ════ -->
  {featuredPost && (
    <section class="home-featured">
      <a href={`${import.meta.env.BASE_URL}blog/${featuredPost.id}/`} class="home-featured-link">
        <div class="home-featured-bg">
          <div class="home-featured-overlay"></div>
          <div class="home-featured-content">
            <span class="home-featured-kicker">精选文章</span>
            <h2 class="home-featured-title">{featuredPost.data.title}</h2>
            <p class="home-featured-desc">{featuredPost.data.description}</p>
            <div class="home-featured-meta">
              <span class="seal">{featuredPost.data.category}</span>
              <time class="home-featured-time">{featuredPost.data.pubDate.toLocaleDateString('zh-CN', { year: 'numeric', month: 'short', day: 'numeric' })}</time>
            </div>
          </div>
        </div>
      </a>
    </section>
  )}

  <!-- ════ BENTO POST GRID ════ -->
  <section class="home-posts">
    <div class="home-posts-header">
      <h2 class="section-kicker">最新文章</h2>
      <a href={`${import.meta.env.BASE_URL}blog/`} class="home-posts-all">
        查看全部 &rarr;
      </a>
    </div>

    {recentPosts.length > 0 ? (
      <div class="home-grid-2col">
        {recentPosts.map((post, i) => (
          <div class="reveal-target" style={`transition-delay: ${(i * 0.04).toFixed(2)}s`}>
            <PostCard
              title={post.data.title}
              description={post.data.description}
              pubDate={post.data.pubDate}
              tags={post.data.tags}
              category={post.data.category}
              slug={post.id}
              readingTime={calcReadingTime(post.body || '')}
              featured={false}
            />
          </div>
        ))}
      </div>
    ) : (
      <div class="home-empty">
        <p class="text-lg mb-2 font-serif">还没有文章</p>
        <p class="text-sm">在 <code class="px-2 py-0.5 bg-surface-alt rounded text-xs">src/content/posts/</code> 目录下添加 Markdown 文件即可</p>
      </div>
    )}
  </section>

  <!-- ════ CATEGORIES + TAGS (compact) ════ -->
  <section class="home-tax">
    <div class="home-tax-inner">
      {categories.length > 0 && (
        <div class="home-tax-group">
          <span class="home-tax-label">分类</span>
          <div class="home-tax-items">
            {categories.sort((a, b) => b.count - a.count).map((cat) => (
              <a href={`${import.meta.env.BASE_URL}blog/?category=${encodeURIComponent(cat.name)}`}
                class="home-tax-chip">
                {cat.name}
                <span>{cat.count}</span>
              </a>
            ))}
          </div>
        </div>
      )}
      {allTags.length > 0 && (
        <div class="home-tax-group">
          <span class="home-tax-label">标签</span>
          <div class="home-tax-items">
            {allTags.slice(0, 20).map((tag) => (
              <a href={`${import.meta.env.BASE_URL}tag/${tag}/`}
                class="home-tax-tag">
                #{tag}
              </a>
            ))}
          </div>
        </div>
      )}
    </div>
  </section>

  <!-- ════ TECH DAILY ════ -->
  <section class="home-daily reveal-target">
    <div class="home-daily-inner">
      <div class="flex items-center justify-between mb-8">
        <h2 class="section-kicker">技术日报</h2>
        <a href="https://ekegukeku64-blip.github.io/tech-daily/" target="_blank" rel="noopener" class="home-posts-all">
          查看全部 &rarr;
        </a>
      </div>
      <div id="tech-daily-grid" class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="col-span-3 text-center py-8 text-sm text-text-muted/50 font-serif">加载中...</div>
      </div>
    </div>
  </section>

  <!-- ════ FOOTNOTE ════ -->
  <section class="home-footnote">
    <div class="home-footnote-divider"></div>
    <div class="home-footnote-text">
      <span class="font-display font-bold">墨迹</span>
      <span class="mx-3 opacity-20">·</span>
      <span>不端着，先做出来。</span>
    </div>
  </section>

<script is:inline>
document.addEventListener('astro:page-load', async () => {
  const grid = document.getElementById('tech-daily-grid');
  if (!grid) return;
  try {
    const resp = await fetch('https://ekegukeku64-blip.github.io/tech-daily/sitemap-0.xml');
    const xml = await resp.text();
    const matches = [...xml.matchAll(/<loc>(https:\/\/[^<]*daily-tech-(\d{4}-\d{2}-\d{2})[^<]*)<\/loc>/g)];
    matches.sort((a, b) => b[2].localeCompare(a[2]));
    const links = matches.slice(0, 3).map(m => ({ url: m[1], date: m[2] }));
    if (links.length === 0) {
      grid.innerHTML = '<div class="col-span-3 text-center py-8 text-sm text-text-muted/50 font-serif">暂无内容</div>';
      return;
    }
    grid.innerHTML = links.map(({ url, date }) => `
      <div class="card-tilt-wrapper">
        <a href="${url}" target="_blank" rel="noopener" class="card card-tilt group block p-5">
          <div class="card-tilt-spotlight" aria-hidden="true"></div>
          <time class="text-[11px] text-text-secondary font-mono">${date}</time>
          <h3 class="mt-2 font-display text-base font-bold text-text leading-snug group-hover:text-accent transition-colors duration-200">
            技术日报 · ${date.slice(5)}
          </h3>
          <p class="mt-1.5 text-sm text-text-secondary line-clamp-2 leading-relaxed">
            GitHub 热门项目 + HN 技术圈每日动态
          </p>
        </a>
      </div>
    `).join('');
    // Init tilt for daily cards
    document.querySelectorAll('#tech-daily-grid .card-tilt-wrapper').forEach(initTiltDaily);
  } catch {
    grid.innerHTML = '<div class="col-span-3 text-center py-8 text-sm text-text-muted/50 font-serif">日报暂不可用</div>';
  }
});

// Tilt for daily cards (same effect as PostCard)
const MAX_TILT_DAILY = 3.0;
function initTiltDaily(wrapper) {
  const card = wrapper.querySelector('.card-tilt');
  if (!card) return;
  wrapper.style.perspective = '800px';
  wrapper.addEventListener('mousemove', (e) => {
    const rect = wrapper.getBoundingClientRect();
    const x = (e.clientX - rect.left) / rect.width;
    const y = (e.clientY - rect.top) / rect.height;
    const tiltX = (y - 0.5) * 2 * MAX_TILT_DAILY;
    const tiltY = (x - 0.5) * -2 * MAX_TILT_DAILY;
    card.style.transform = \`rotateX(\${tiltX}deg) rotateY(\${tiltY}deg) translateY(\${-((1 - Math.min(Math.hypot(x-0.5, y-0.5) * 1.4, 1)) * 10)}px)\`;
  });
  wrapper.addEventListener('mouseleave', () => {
    card.style.transform = '';
  });
}
</script>


