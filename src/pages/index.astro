---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="墨迹 - Entrance">
  <script src={`${import.meta.env.BASE_URL}scripts/shader-splash.js`} type="module"></script>
  <main class="entrance-container">
    <div class="bg-layer">
      <video
        id="entrance-video"
        class="bg-media"
        poster={`${import.meta.env.BASE_URL}maple.jpg`}
        loop
        muted
        playsinline>
      </video>
    </div>

    <div class="fog-veil" aria-hidden="true"></div>

    <!-- SVG filters for liquid glass button -->
    <svg class="hidden"><defs><filter id="btn-glass" x="0%" y="0%" width="100%" height="100%" color-interpolation-filters="sRGB"><feTurbulence type="fractalNoise" baseFrequency="0.05 0.05" numOctaves="1" seed="1" result="turbulence"/><feGaussianBlur in="turbulence" stdDeviation="2" result="blurredNoise"/><feDisplacementMap in="SourceGraphic" in2="blurredNoise" scale="70" xChannelSelector="R" yChannelSelector="B" result="displaced"/><feGaussianBlur in="displaced" stdDeviation="4" result="finalBlur"/><feComposite in="finalBlur" in2="finalBlur" operator="over"/></filter></defs></svg>

    <div class="content-layer">
      <h1 class="blur-reveal title">墨迹</h1>
      <p class="blur-reveal subtitle">一个不装成熟的个人空间</p>

      <a href={`${import.meta.env.BASE_URL}home/`} class="blur-reveal enter-btn">
        <span class="btn-glass-overlay" aria-hidden="true"></span>
        <span class="btn-text">Enter Room</span>
      </a>
    </div>
  </main>

  <script is:inline>
    const v = document.getElementById('entrance-video');
    if (v) {
      const isMobile = window.matchMedia('(max-width: 768px)').matches;
      if (!isMobile) {
        const loadAndPlay = () => {
          if (!v.src) {
            v.src = '/blog/maple.mp4';
            v.load();
          }
          v.play().catch(() => {});
        };
        if (window.requestIdleCallback) {
          requestIdleCallback(loadAndPlay, { timeout: 3000 });
        } else {
          setTimeout(loadAndPlay, 1500);
        }
        document.addEventListener('click', () => v.play().catch(() => {}), { once: true });
      }
    }
  </script>
</BaseLayout>

<style>
  .entrance-container {
    position: relative;
    width: 100%;
    height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background-color: #070A13;
  }

  .entrance-container::after {
    content: "";
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 90%;
    background: linear-gradient(to top,
      rgba(5,7,13,0.9) 0%,
      rgba(5,7,13,0.6) 28%,
      rgba(5,7,13,0.3) 52%,
      rgba(5,7,13,0.08) 74%,
      transparent 100%);
    z-index: 5;
    pointer-events: none;
  }

  .bg-layer {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
  }

  .bg-media {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.38;
    filter: saturate(0.85);
    transform: scale(1.06);
  }

  .fog-veil {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      radial-gradient(ellipse 60% 50% at 50% 40%, transparent 35%, rgba(7,10,19,0.55) 100%);
    pointer-events: none;
  }

  .content-layer {
    position: relative;
    z-index: 10;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    margin-top: 6rem;
  }

  .title {
    font-family: 'Noto Serif SC', serif;
    font-size: 5rem;
    font-weight: 700;
    color: rgba(242, 238, 234, 0.68);
    margin: 0;
    letter-spacing: 0.14em;
    text-shadow: 0 0 120px rgba(122, 149, 175, 0.18), 0 0 40px rgba(200, 180, 140, 0.12);
  }

  .subtitle {
    font-size: 1rem;
    color: rgba(175, 168, 158, 0.55);
    letter-spacing: 0.28em;
    margin-top: 1.2rem;
    margin-bottom: 3.5rem;
  }

  .enter-btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 1rem 3.5rem;
    font-size: 0.85rem;
    letter-spacing: 0.24em;
    text-decoration: none;
    text-transform: uppercase;
    font-weight: 600;
    color: rgba(245, 245, 245, 0.78);
    border: none;
    border-radius: 100px;
    cursor: pointer;
    outline: none;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    background: transparent;
    /* Liquid glass shadow stack */
    box-shadow:
      0 0 8px rgba(0, 0, 0, 0.03),
      0 2px 6px rgba(0, 0, 0, 0.08),
      inset 3px 3px 0.5px -3.5px rgba(255, 255, 255, 0.09),
      inset -3px -3px 0.5px -3.5px rgba(255, 255, 255, 0.85),
      inset 1px 1px 1px -0.5px rgba(255, 255, 255, 0.6),
      inset -1px -1px 1px -0.5px rgba(255, 255, 255, 0.6),
      inset 0 0 6px 6px rgba(255, 255, 255, 0.12),
      inset 0 0 2px 2px rgba(255, 255, 255, 0.06),
      0 0 12px rgba(0, 0, 0, 0.15);
  }

  .btn-glass-overlay {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 0;
    height: 100%;
    width: 100%;
    border-radius: 100px;
    backdrop-filter: url(#btn-glass);
    transition: all 0.3s ease;
    pointer-events: none;
  }

  .btn-text {
    position: relative;
    z-index: 10;
  }

  .enter-btn:hover {
    color: rgba(255, 255, 255, 0.92);
    transform: scale(1.03);
    box-shadow:
      0 0 12px rgba(0, 0, 0, 0.05),
      0 4px 12px rgba(0, 0, 0, 0.12),
      inset 3px 3px 0.5px -3px rgba(255, 255, 255, 0.14),
      inset -3px -3px 0.5px -3px rgba(255, 255, 255, 0.9),
      inset 1px 1px 1px -0.5px rgba(255, 255, 255, 0.7),
      inset -1px -1px 1px -0.5px rgba(255, 255, 255, 0.7),
      inset 0 0 8px 8px rgba(255, 255, 255, 0.15),
      inset 0 0 3px 3px rgba(255, 255, 255, 0.08),
      0 0 20px rgba(122, 149, 175, 0.15);
  }

  .enter-btn:active {
    transform: scale(0.96) translateY(2px);
    transition: transform 0.1s ease-out;
    box-shadow:
      0 1px 2px rgba(0, 0, 0, 0.15),
      inset 3px 3px 0.5px -4px rgba(255, 255, 255, 0.04),
      inset -3px -3px 0.5px -4px rgba(255, 255, 255, 0.4),
      inset 1px 1px 1px -1px rgba(255, 255, 255, 0.3),
      inset -1px -1px 1px -1px rgba(255, 255, 255, 0.3),
      inset 0 0 4px 4px rgba(255, 255, 255, 0.06),
      inset 0 0 1px 1px rgba(255, 255, 255, 0.03);
  }

  .enter-btn::after {
    content: "";
    position: absolute;
    top: calc(100% + 2rem);
    left: 50%;
    transform: translateX(-50%);
    width: 1px;
    height: 80px;
    background: linear-gradient(to bottom, rgba(122, 149, 175, 0.12), rgba(122, 149, 175, 0.01), transparent);
    pointer-events: none;
  }

  .blur-reveal {
    opacity: 0;
    filter: blur(12px);
    transform: translateY(20px);
    animation: blurFadeIn 1.5s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .title { animation-delay: 0.2s; }
  .subtitle { animation-delay: 0.4s; }
  .enter-btn { animation-delay: 0.8s; }

  @keyframes blurFadeIn {
    to {
      opacity: 1;
      filter: blur(0);
      transform: translateY(0);
    }
  }

  @media (max-width: 768px) {
    .title { font-size: 3rem; }
    .content-layer { margin-top: 3rem; }
  }
</style>
