---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('posts', ({ data }) => !data.draft);
const sorted = posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Extract all categories with counts
const catMap = new Map<string, number>();
for (const p of sorted) {
  const cat = p.data.category || '未分类';
  catMap.set(cat, (catMap.get(cat) || 0) + 1);
}
const categories = Array.from(catMap.entries()).sort((a, b) => b[1] - a[1]);

// Group by year
const postsByYear = new Map<number, typeof posts>();
for (const post of sorted) {
  const year = post.data.pubDate.getFullYear();
  if (!postsByYear.has(year)) postsByYear.set(year, []);
  postsByYear.get(year)!.push(post);
}
const years = Array.from(postsByYear.keys()).sort((a, b) => b - a);

function formatDate(date: Date) {
  return date.toLocaleDateString('zh-CN', { month: '2-digit', day: '2-digit' });
}

const base = import.meta.env.BASE_URL;
---

<BaseLayout title="归档 - 墨迹" description="所有文章按时间归档">
  <div class="max-w-3xl mx-auto px-6 py-16">
    <!-- Header -->
    <div class="mb-10">
      <span class="inline-block px-3 py-1 text-[10px] font-sans tracking-[0.2em] uppercase text-accent border border-accent/25 rounded-full mb-5">Archive</span>
      <h1 class="font-display text-4xl md:text-5xl font-bold text-text mb-3">归档</h1>
      <p class="text-text-muted font-serif text-lg">
        {posts.length} 篇文章 · {catMap.size} 个分类
      </p>
    </div>

    <!-- Category filter tabs -->
    <div class="flex flex-wrap gap-2 mb-12" id="cat-filters">
      <button data-cat="all" class="cat-tab active px-4 py-2 text-sm rounded-full border border-border-strong bg-white/8 text-text font-medium transition-all duration-300 hover:border-accent/40">
        全部 ({posts.length})
      </button>
      {categories.map(([cat, count]) => (
        <button data-cat={cat} class="cat-tab px-4 py-2 text-sm rounded-full border border-border bg-transparent text-text-muted font-medium transition-all duration-300 hover:border-border-strong hover:text-text hover:bg-white/5">
          {cat} ({count})
        </button>
      ))}
    </div>

    <!-- Timeline -->
    <div class="relative">
      <!-- Vertical line -->
      <div class="absolute left-[15px] md:left-[23px] top-2 bottom-0 w-px bg-gradient-to-b from-accent/30 via-border to-transparent"></div>

      {years.map(year => (
        <div class="relative mb-16" data-year={year}>
          <!-- Year header -->
          <div class="flex items-center gap-5 mb-8">
            <div class="relative shrink-0">
              <div class="w-[30px] h-[30px] md:w-[46px] md:h-[46px] rounded-full bg-surface-raised border-2 border-accent/30 flex items-center justify-center shadow-[0_0_20px_rgba(122,149,175,0.15)] z-10 relative">
                <span class="text-[10px] md:text-xs font-mono text-accent font-bold">{String(year).slice(2)}</span>
              </div>
            </div>
            <div>
              <h2 class="font-display text-3xl md:text-4xl font-bold text-text leading-none">{year}</h2>
              <span class="text-xs text-text-muted mt-1 block">{postsByYear.get(year)!.length} 篇文章</span>
            </div>
          </div>

          <!-- Post cards -->
          <div class="ml-[50px] md:ml-[74px] space-y-3">
            {postsByYear.get(year)!.map((post, i) => {
              const cat = post.data.category || '未分类';
              return (
                <a
                  href={`${base}blog/${post.id}`}
                  data-category={cat}
                  class="group block relative p-5 rounded-xl border border-border bg-surface/40 hover:bg-surface-alt/60 hover:border-accent/20 transition-all duration-500 overflow-hidden"
                >
                  {/* Hover glow */}
                  <div class="absolute inset-0 rounded-xl opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none"
                    style="background: radial-gradient(400px circle at var(--mouse-x, 50%) var(--mouse-y, 50%), rgba(122,149,175,0.04), transparent 70%);"></div>

                  <div class="relative flex items-start justify-between gap-4">
                    <div class="flex-1 min-w-0">
                      <div class="flex items-center gap-3 mb-2">
                        <time datetime={post.data.pubDate.toISOString()} class="text-xs font-mono text-text-muted/70 tabular-nums shrink-0">
                          {formatDate(post.data.pubDate)}
                        </time>
                        <span class="text-[10px] px-2 py-0.5 rounded-full bg-accent/10 text-accent/80 font-sans">
                          {cat}
                        </span>
                      </div>
                      <h3 class="font-display text-base md:text-lg font-bold text-text leading-snug group-hover:text-accent transition-colors duration-300">
                        {post.data.title}
                      </h3>
                      {post.data.description && (
                        <p class="mt-1.5 text-sm text-text-muted line-clamp-1 font-serif">
                          {post.data.description}
                        </p>
                      )}
                    </div>
                    {post.data.tags && post.data.tags.length > 0 && (
                      <div class="hidden sm:flex flex-wrap gap-1 shrink-0 pt-1">
                        {post.data.tags.slice(0, 3).map(tag => (
                          <span class="text-[10px] px-1.5 py-0.5 rounded-md bg-white/[0.03] text-text-muted/60 border border-white/[0.04]">
                            {tag}
                          </span>
                        ))}
                      </div>
                    )}
                  </div>
                </a>
              );
            })}
          </div>
        </div>
      ))}
    </div>

    <!-- Footer nav -->
    <div class="mt-10 text-center">
      <a
        href={`${base}blog`}
        class="inline-flex items-center gap-2 px-6 py-3 rounded-xl border border-border text-text-muted
               hover:border-accent/40 hover:text-accent hover:shadow-lg hover:shadow-accent/5
               transition-all duration-500 font-medium text-sm"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        返回文章列表
      </a>
    </div>
  </div>
</BaseLayout>

<script is:inline>
  // Category filter
  document.addEventListener('astro:page-load', () => {
    const tabs = document.querySelectorAll('#cat-filters .cat-tab');
    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const cat = tab.dataset.cat;
        tabs.forEach(t => t.classList.remove('active', 'bg-white/8', 'text-text', 'border-border-strong'));
        tabs.forEach(t => t.classList.add('bg-transparent', 'text-text-muted', 'border-border'));
        tab.classList.add('active', 'bg-white/8', 'text-text', 'border-border-strong');

        document.querySelectorAll('[data-category]').forEach(el => {
          if (cat === 'all' || (el as HTMLElement).dataset.category === cat) {
            el.classList.remove('hidden');
          } else {
            el.classList.add('hidden');
          }
        });

        // Show/hide year sections
        document.querySelectorAll('[data-year]').forEach((section) => {
          const visible = section.querySelectorAll('[data-category]:not(.hidden)');
          if (visible.length === 0) {
            section.classList.add('hidden');
          } else {
            section.classList.remove('hidden');
          }
        });
      });
    });

    // Mouse glow tracking
    document.querySelectorAll('[data-category]').forEach(card => {
      card.addEventListener('mousemove', (e) => {
        const rect = (card as HTMLElement).getBoundingClientRect();
        const x = ((e.clientX - rect.left) / rect.width * 100).toFixed(1);
        const y = ((e.clientY - rect.top) / rect.height * 100).toFixed(1);
        (card as HTMLElement).style.setProperty('--mouse-x', `${x}%`);
        (card as HTMLElement).style.setProperty('--mouse-y', `${y}%`);
      });
    });
  });
</script>

<style>
  .cat-tab.active {
    border-color: rgba(122, 149, 175, 0.4) !important;
    box-shadow: 0 0 20px rgba(122, 149, 175, 0.06);
  }
</style>
