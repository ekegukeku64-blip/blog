---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('posts', ({ data }) => !data.draft);
const sorted = posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Group posts by year
const postsByYear = new Map<number, typeof posts>();
for (const post of sorted) {
  const year = post.data.pubDate.getFullYear();
  if (!postsByYear.has(year)) {
    postsByYear.set(year, []);
  }
  postsByYear.get(year)!.push(post);
}

const years = Array.from(postsByYear.keys()).sort((a, b) => b - a);

function formatDate(date: Date) {
  return date.toLocaleDateString('zh-CN', { month: 'long', day: 'numeric' });
}

const base = import.meta.env.BASE_URL;
---

<BaseLayout title="归档 - 墨迹" description="所有文章按时间归档">
  <div class="max-w-3xl mx-auto px-6 py-16">
    <!-- Header -->
    <div class="mb-12">
      <span class="inline-block px-3 py-1 text-xs font-sans tracking-widest text-accent dark:text-dark-accent border border-accent/30 dark:border-dark-accent/30 mb-4">ARCHIVE</span>
      <h1 class="font-display text-4xl font-bold text-text dark:text-dark-text mb-3">
        归档
      </h1>
      <p class="text-lg text-text-muted dark:text-dark-text-muted font-serif">
        共 {posts.length} 篇文章
      </p>
    </div>

    <!-- Archive Timeline -->
    <div class="relative">
      <!-- Vertical line -->
      <div class="absolute left-4 md:left-8 top-0 bottom-0 w-px bg-gradient-to-b from-accent/40 via-border/40 to-transparent dark:from-dark-accent/40 dark:via-dark-border/40"></div>

      {years.map(year => (
        <div class="relative mb-14">
          <!-- Year marker -->
          <div class="relative flex items-center mb-6">
            <div class="absolute left-4 md:left-8 w-4 h-4 rounded-full bg-accent dark:bg-dark-accent -translate-x-1/2 shadow-lg shadow-accent/30 dark:shadow-dark-accent/30"></div>
            <h2 class="ml-14 md:ml-18 font-display text-2xl font-bold text-text dark:text-dark-text">
              {year}
            </h2>
            <span class="ml-3 text-sm text-text-muted dark:text-dark-text-muted bg-surface-alt dark:bg-dark-surface-alt px-2.5 py-0.5 rounded-full">
              {postsByYear.get(year)!.length} 篇
            </span>
          </div>

          <!-- Posts list -->
          <div class="ml-14 md:ml-18 space-y-4">
            {postsByYear.get(year)!.map(post => (
              <a
                href={`${base}blog/${post.id}`}
                class="group block p-5 rounded-xl shadow-sm border border-border/40 dark:border-dark-border/40
                       hover:border-accent/60 dark:hover:border-dark-accent/60
                       hover:bg-surface-alt/50 dark:hover:bg-dark-surface-alt/50
                       hover:shadow-lg hover:shadow-accent/5 dark:hover:shadow-dark-accent/5
                       transition-all duration-300"
              >
                <div class="flex items-start justify-between gap-4">
                  <div class="flex-1 min-w-0">
                    <h3 class="font-display text-lg font-bold text-text dark:text-dark-text leading-snug
                               group-hover:text-accent dark:group-hover:text-dark-accent transition-colors">
                      {post.data.title}
                    </h3>
                    <p class="mt-2 text-sm text-text-muted dark:text-dark-text-muted line-clamp-2">
                      {post.data.description}
                    </p>
                    <div class="mt-3 flex flex-wrap items-center gap-2">
                      <time datetime={post.data.pubDate.toISOString()} class="text-xs text-text-muted dark:text-dark-text-muted font-serif">
                        {formatDate(post.data.pubDate)}
                      </time>
                      {post.data.category && (
                        <span class="text-xs px-2 py-0.5 rounded-full bg-surface-alt dark:bg-dark-surface-alt text-text-muted dark:text-dark-text-muted">
                          {post.data.category}
                        </span>
                      )}
                    </div>
                  </div>
                  <div class="flex flex-wrap gap-1 shrink-0">
                    {post.data.tags?.slice(0, 3).map(tag => (
                      <span class="text-xs px-2 py-0.5 rounded-full bg-accent/10 dark:bg-dark-accent/10 text-accent dark:text-dark-accent">
                        {tag}
                      </span>
                    ))}
                  </div>
                </div>
              </a>
            ))}
          </div>
        </div>
      ))}
    </div>

    <!-- Back to top -->
    <div class="mt-14 text-center">
      <a
        href={`${base}blog`}
        class="inline-flex items-center gap-2 px-7 py-3.5 rounded-xl
               border border-border/60 dark:border-dark-border/60
               text-text-muted dark:text-dark-text-muted
               hover:border-accent hover:text-accent
               dark:hover:border-dark-accent dark:hover:text-dark-accent
               hover:shadow-lg hover:shadow-accent/10 dark:hover:shadow-dark-accent/10
               transition-all duration-300 font-medium"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        返回文章列表
      </a>
    </div>
  </div>
</BaseLayout>
